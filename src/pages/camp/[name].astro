---
import Layout from '../../layouts/Layout.astro';
import CampMap from '../../components/CampMap.astro';
import campgrounds from '../../data/campgrounds_enriched.json';
import productData from '../../data/products.json';

export async function getStaticPaths() {
  return campgrounds.map((camp) => ({
    params: { name: camp.name },
    props: { camp },
  }));
}


const { camp } = Astro.props;

// Release Date Logic (PSEO Drip Feed)
// If release_date is in the future, we show the page but tell Google NOINDEX.
const today = new Date();
const releaseDate = camp.release_date ? new Date(camp.release_date) : new Date('2000-01-01');
const isReleased = releaseDate <= today;
const shouldIndex = isReleased || import.meta.env.DEV; // Always index in dev for testing

// Affiliate Logic Helpers
const isHighAltitude = camp.elevation > 1000;
const isGlamping = camp.features.has_glamping;
const isTraditional = !isGlamping; // Helper for Traditional Camps

// 🟢 [Configuration] 請在此填入您的通路王 Klook 推廣連結結構
// 格式: https://product.mchannles.com/redirect_wa.php?k={您的K值}&tourl=
const ICHANNELS_PREFIX = "https://product.mchannles.com/redirect_wa.php?k=3P17C&tourl="; 

const KLOOK_SEARCH_BASE = "https://www.klook.com/zh-TW/activity/list/?keywords=";
const ASIAYO_SEARCH_BASE = "https://asiayo.com/zh-tw/search/?keyword=";

// Generate product recommendations based on tags/features AND content keywords
const getAffiliateProducts = () => {
    // Combine all text for keyword search
    const fullText = (camp.description + camp.tags.join(' ')).toLowerCase();

    // Deep clone the data to avoid modifying the original source reference
    const recommendations = JSON.parse(JSON.stringify(productData));

    const filteredGroups = recommendations.filter(group => {
        // 🔮 策略：針對訂房連結 (Booking) 進行動態優化
        if (group.id === 'booking-always') {
             group.items.forEach(item => {
                let targetUrl = item.link;
                
                // Klook Strategy
                if (item.name.includes("Klook")) {
                    if (isTraditional) {
                        // 👑 策略一：改推「地區性替代方案」 (轉化意圖)
                        // 既然無法訂這間，就讓他訂「同一區」的其他營位
                        const cityKeywords = `${camp.city} 露營`;
                        targetUrl = `${KLOOK_SEARCH_BASE}${encodeURIComponent(cityKeywords)}`;
                        
                        item.name = `搜尋${camp.city}熱門營位`;
                        item.desc = `此營區目前無法線上預訂，看看${camp.city}其他空位`;
                        item.cta = "查空房";
                    } else {
                        // 豪華露營：嘗試精準搜尋 (通常 Klook 會有)
                        targetUrl = `${KLOOK_SEARCH_BASE}${encodeURIComponent(camp.name)}`;
                        item.desc = `立即查詢「${camp.name}」優惠價格`;
                        item.cta = "查優惠";
                    }
                }

                // AsiaYo Strategy
                if (item.name.includes("AsiaYo")) {
                     if (isTraditional) {
                        // 傳統營地：改推該地區的「免裝備/露營車」體驗
                        targetUrl = `${ASIAYO_SEARCH_BASE}${encodeURIComponent(camp.city)}`; 
                        item.desc = `不想搭帳棚？找找${camp.city}的露營車`;
                        item.cta = "比價去";
                     } else {
                        // 豪華露營：精準搜尋
                        targetUrl = `${ASIAYO_SEARCH_BASE}${encodeURIComponent(camp.name)}`;
                        item.desc = `搜尋「${camp.name}」最新報價`;
                     }
                }

                // 3. 包裝分潤連結 (最後一步)
                if (ICHANNELS_PREFIX) {
                    item.link = `${ICHANNELS_PREFIX}${encodeURIComponent(targetUrl)}`;
                } else {
                    item.link = targetUrl;
                }
            });
            return true;
        }
        
        // 1. Tag/Feature Matching
        if (group.tags.includes('high_altitude') && isHighAltitude) return true;
        if (group.tags.includes('glamping') && isGlamping) return true;
        
        // 2. Keyword Matching (Automated Contextual Ads)
        if (group.keywords && group.keywords.length > 0) {
            // Check if ANY keyword exists in the description or tags
            const hasKeyword = group.keywords.some(keyword => fullText.includes(keyword.toLowerCase()));
            if (hasKeyword) return true;
        }

        return false;
    });

    // 👑 策略二：全力轉攻「裝備導購」 (Gear First Strategy)
    // 如果是傳統營地 (Traditional)，將「訂房連結」移到最後面，優先展示「裝備」
    if (isTraditional) {
        const bookingGroupIndex = filteredGroups.findIndex(g => g.id === 'booking-always');
        if (bookingGroupIndex > -1) {
            const [bookingGroup] = filteredGroups.splice(bookingGroupIndex, 1);
            filteredGroups.push(bookingGroup); // Move to bottom
        }
    }

    return filteredGroups;
};

const recommendations = getAffiliateProducts();

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Campground",
  "name": camp.name,
  "description": camp.description,
  "telephone": camp.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": camp.address,
    "addressLocality": camp.area,
    "addressRegion": camp.city,
    "addressCountry": "TW"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": camp.lat,
    "longitude": camp.lng
  },
  "elevation": camp.elevation,
  "priceRange": "$$"
};
---

<Layout title={`${camp.name} - ${camp.city}${camp.area}露營區推薦 | 台灣露營地圖`} description={camp.description.substring(0, 150) + '...'}>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemaData)}></script>
    
    {/* PSEO Drip Feed Control */}
    {!shouldIndex && <meta name="robots" content="noindex, nofollow" slot="head" />}

    {/* Hero Section - Mobile First Design */}
    <div class="bg-stone-100 border-b border-stone-200">
        <div class="container mx-auto px-4 py-3 text-sm text-stone-500">
            <a href="/" class="hover:text-emerald-700">首頁</a> &rsaquo; 
            <span class="mx-1">{camp.city}</span> &rsaquo; 
            <span class="mx-1">{camp.area}</span> &rsaquo; 
            <span class="text-stone-800 font-medium">{camp.name}</span>
        </div>
    </div>

    <div class="container mx-auto px-4 py-8 md:py-12 pb-24 md:pb-12">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
            
            {/* Main Content (Left Column) */}
            <div class="lg:col-span-2">
                <header class="mb-6 md:mb-8">
                    <div class="flex flex-wrap items-center gap-3 mb-3">
                        {camp.features.high_altitude && <span class="bg-blue-600 text-white text-xs font-bold px-2 py-1 rounded">高海拔 {camp.elevation}m</span>}
                        {camp.features.has_glamping && <span class="bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded">豪華露營</span>}
                        {camp.features.pet_friendly && <span class="bg-emerald-600 text-white text-xs font-bold px-2 py-1 rounded">寵物友善</span>}
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-stone-900 mb-2">{camp.name}</h1>
                    <div class="flex items-center text-stone-600 text-sm md:text-base gap-4">
                        <span class="flex items-center gap-1"><span class="text-xl">📍</span> {camp.address}</span>
                    </div>
                </header>

                {/* Map Component - Full width on mobile, top position */}
                <div class="bg-stone-200 rounded-2xl h-64 md:h-96 w-full mb-8 relative border border-stone-300 overflow-hidden shadow-inner group">
                   <CampMap lat={camp.lat} lng={camp.lng} name={camp.name} />
                   <a href={`https://www.google.com/maps/search/?api=1&query=${camp.lat},${camp.lng}`} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-lg shadow-lg text-sm font-bold text-emerald-700 hover:bg-emerald-50 transition flex items-center gap-2 z-[400] active:scale-95">
                        <span>🧭</span> Google 導航
                   </a>
                </div>

                {/* Description - Enhanced Typography */}
                <article class="prose prose-stone prose-lg md:prose-xl max-w-none mb-12 prose-headings:font-bold prose-p:text-stone-700 prose-a:text-emerald-600">
                    <h2 class="text-2xl font-bold text-stone-800 mb-4 border-l-4 border-emerald-500 pl-4">營區介紹</h2>
                    <p class="text-lg md:text-xl leading-relaxed text-stone-700 tracking-wide">{camp.description}</p>
                    
                    <div class="mt-8 flex flex-wrap gap-2 not-prose">
                        {camp.tags.map(tag => (
                            <span class="bg-stone-100 text-stone-600 px-3 py-1.5 rounded-full text-base border border-stone-200">
                                #{tag}
                            </span>
                        ))}
                    </div>
                </article>

                {/* Info Cards */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
                    <div class="bg-emerald-50 p-6 rounded-xl border border-emerald-100">
                        <h3 class="font-bold text-emerald-800 mb-4 flex items-center gap-2">
                            <span>📞</span> 聯絡資訊
                        </h3>
                        <p class="text-emerald-900 font-medium text-lg mb-2">{camp.phone || "未提供電話"}</p>
                        <p class="text-sm text-emerald-700">建議預訂前先致電確認營況</p>
                    </div>
                    <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
                        <h3 class="font-bold text-blue-800 mb-4 flex items-center gap-2">
                            <span>⛰️</span> 地理環境
                        </h3>
                        <div class="flex justify-between items-center border-b border-blue-200 pb-2 mb-2">
                            <span class="text-blue-700">海拔高度</span>
                            <span class="font-bold text-blue-900">{camp.elevation} 公尺</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-blue-700">所在區域</span>
                            <span class="font-bold text-blue-900">{camp.city} {camp.area}</span>
                        </div>
                    </div>
                </div>
            </div>

            {/* Sidebar (Right Column - Monetization) */}
            <div class="lg:col-span-1">
                <div class="sticky top-24 space-y-8">
                    
                   {/* Contextual Ads / Recommendations - Enhanced UI */}
                   {recommendations.map((rec, idx) => (
                       <div class="bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden">
                           <div class={`p-4 border-b border-stone-100 ${idx === 0 ? 'bg-gradient-to-r from-emerald-50 to-teal-50' : 'bg-stone-50'}`}>
                               <h3 class="font-bold text-stone-800 text-lg flex items-center gap-2">
                                   {rec.title}
                               </h3>
                           </div>
                           <div class="divide-y divide-stone-100">
                               {rec.items.map(item => (
                                   <a href={item.link} target="_blank" rel="noopener noreferrer" class="group block p-4 hover:bg-stone-50 transition relative overflow-hidden">
                                        <div class="flex justify-between items-start mb-1 relative z-10">
                                            <div>
                                                <h4 class="font-bold text-stone-800 group-hover:text-emerald-700 transition flex items-center gap-1.5">
                                                    {item.name}
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity transform -translate-x-2 group-hover:translate-x-0">
                                                      <path fill-rule="evenodd" d="M5 10a.75.75 0 01.75-.75h6.638L10.23 7.29a.75.75 0 111.04-1.08l3.5 3.25a.75.75 0 010 1.08l-3.5 3.25a.75.75 0 11-1.04-1.08l2.158-1.96H5.75A.75.75 0 015 10z" clip-rule="evenodd" />
                                                    </svg>
                                                </h4>
                                                <p class="text-xs text-stone-500 mt-0.5 line-clamp-1">{item.desc}</p>
                                            </div>
                                            <span class="text-emerald-700 font-bold text-sm bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-100 whitespace-nowrap group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
                                                {item.price}
                                            </span>
                                        </div>
                                        
                                        <div class="mt-3 flex justify-end">
                                             <span class="text-xs font-semibold text-stone-400 group-hover:text-emerald-600 flex items-center gap-1 transition-colors">
                                                 {item.cta || '前往購買'}
                                                 <span>→</span>
                                             </span>
                                        </div>
                                   </a>
                               ))}
                           </div>
                       </div>
                   ))}

                    {/* Google Ads Placeholder */}
                   <div class="bg-stone-100 rounded-xl h-64 flex flex-col items-center justify-center text-stone-400 border border-stone-200 border-dashed">
                       <span class="text-sm font-semibold">廣告版位</span>
                       <span class="text-xs">(Google AdSense)</span>
                   </div>

                </div>
            </div>

        </div>
    </div>

    {/* Sticky Bottom Bar for Mobile Conversion */}
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-stone-200 p-4 pb-safe z-50 md:hidden shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)]">
        <div class="grid grid-cols-5 gap-4 items-center h-12">
            <div class="col-span-2 text-xs text-stone-500">
                <p>每晚參考價</p>
                <p class="text-lg font-bold text-red-600">NT$ 1200 <span class="text-xs font-normal text-stone-400">起</span></p>
            </div>
            <a href="#" class="col-span-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg h-full flex items-center justify-center shadow-md active:scale-95 transition-transform">
                前往預訂 / 查看優惠
            </a>
        </div>
    </div>
</Layout>
