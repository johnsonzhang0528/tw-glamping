---
import Layout from '../../layouts/Layout.astro';
import CampMap from '../../components/CampMap.astro';
import GearChecklist from '../../components/GearChecklist.astro';
import BaseShareButtons from '../../components/ShareButtons.astro';
import CampgroundCard from '../../components/CampgroundCard.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';
import NativeAdCard from '../../components/NativeAdCard.astro'; // 🟢 [NEW] Import Ad Card
import campgrounds from '../../data/campgrounds_smart_clean.json';
import productData from '../../data/products.json';
import weatherData from '../../data/weather_forecast.json';

import { getValidCampgrounds } from '../../utils/filterCamps';
import { getClimateBand, getBestMonthsSummary, getSeasons, getDistanceToCityCenter, summarizeCampWeather, isThinCamp } from '../../utils/campData';

export async function getStaticPaths() {
  // 🟢 [SEO Fix] Quality Gate: Filter out low-quality data
  const validCamps = getValidCampgrounds(campgrounds);

  return validCamps.map((camp) => ({
    params: { name: camp.name },
    props: { camp },
  }));
}


const { camp } = Astro.props;
const campWeather = weatherData[camp.name] || [];
const weatherMeta = weatherData["_metadata"] || {};

// 🟢 [T5.4] 品質門檻:薄頁(缺描述/缺標籤/缺座標)自動 noindex,避免低品質頁拖累整站品質評分。
// 目前資料皆通過門檻(desc≥78字、tags≥2、有座標),故所有現有營區維持 index;
// 此為安全網,主要防止未來加入的薄資料被索引。用 noindex(非刪頁)以保留內部連結、避免 404。
const shouldIndex = !isThinCamp(camp);

// SEO Dates Strategy
// datePublished: 使用資料庫中的原始發布時間 (release_date)，確保 "First Seen" 時間點穩定，避免每次 Build 都改變。
// dateModified: 使用 Build Time (new Date())，代表「最近一次驗證/更新資料」的時間，這對目錄型網站是合理的 (Verified Freshness)。
const publishedTime = camp.release_date ? new Date(camp.release_date).toISOString() : new Date().toISOString();
// 🟢 [T5.1] 誠實新鮮度:dateModified 綁真實資料管線執行時間(weather 每日更新),而非無意義的 build time
const _wxMeta = weatherData["_metadata"] || {};
const modifiedTime = _wxMeta.generated_at ? new Date(_wxMeta.generated_at).toISOString() : new Date().toISOString();

// Affiliate Logic Helpers
const isHighAltitude = camp.elevation > 1000;
const isGlamping = camp.features.has_glamping;
const isTraditional = !isGlamping; // Helper for Traditional Camps

// 🟢 [Configuration] Affiliate Configuration
// (Removed legacy affiliate config)

// 🏕️ Facilities & Features Configuration
const FACILITIES_MAPPING = [
    // Hardware / Equipment (Infer from Description or Tags)
    { key: "fridge", keywords: ["冰箱", "冷藏", "冷凍"], icon: "❄️", label: "提供冰箱" },
    { key: "water_dispenser", keywords: ["飲水機"], icon: "💧", label: "飲水機" },
    { key: "wifi", keywords: ["wifi", "網路", "訊號", "4G", "5G"], icon: "📶", label: "Wifi/訊號" },
    { key: "power", keywords: ["供電", "插座", "電源"], icon: "⚡", label: "營位供電" },
    { key: "bathroom", keywords: ["衛浴", "廁所", "淋浴", "吹風機"], icon: "🚿", label: "衛浴/吹風機" },
    { key: "parking", keywords: ["停車"], icon: "🅿️", label: "停車場" },

    // Camp Type / Environment (From Tags)
    { key: "roof", keywords: ["雨棚"], icon: "🏠", label: "雨棚營位" },
    { key: "deck", keywords: ["棧板"], icon: "🪵", label: "棧板營位" },
    { key: "grass", keywords: ["草地", "草皮"], icon: "🌱", label: "草地營位" },
    { key: "gravel", keywords: ["碎石"], icon: "🪨", label: "碎石營位" },
    { key: "forest", keywords: ["森林", "樹林"], icon: "🌲", label: "森林系" },
    { key: "stream", keywords: ["溪流", "玩水", "戲水"], icon: "🌊", label: "戲水/溪流" },
    
    // Activities / Vibe (From Tags)
    { key: "firefly", keywords: ["螢火蟲"], icon: "✨", label: "螢火蟲季節" },
    { key: "sakura", keywords: ["櫻花"], icon: "🌸", label: "櫻花季節" },
    { key: "cloud", keywords: ["雲海"], icon: "☁️", label: "雲海景觀" },
    { key: "night_view", keywords: ["夜景"], icon: "🌃", label: "百萬夜景" },
    { key: "stars", keywords: ["星空", "觀星"], icon: "✨", label: "觀星" },
    { key: "sand", keywords: ["沙坑"], icon: "🏖️", label: "兒童沙坑" },
];

// Helper to determine active facilities
const getFacilities = () => {
    const activeFacilities = [];
    const searchContext = (camp.description + camp.tags.join(' ')).toLowerCase();

    // 1. Check Keywords
    FACILITIES_MAPPING.forEach(fac => {
        if (fac.keywords.some(k => searchContext.includes(k.toLowerCase()))) {
            activeFacilities.push(fac);
        }
    });

    // 2. Add Explicit Feature Flags if not already present
    if (camp.features.pet_friendly && !activeFacilities.find(f => f.label === "寵物友善")) {
        activeFacilities.push({ icon: "🐾", label: "寵物友善" });
    }
    if (camp.features.high_altitude && !activeFacilities.find(f => f.label.includes("海拔"))) {
        activeFacilities.push({ icon: "🏔️", label: "高海拔" });
    }
     if (camp.features.has_glamping && !activeFacilities.find(f => f.label === "豪華露營")) {
        activeFacilities.push({ icon: "⛺", label: "豪華露營" });
    }

    // Deduplicate by label
    return [...new Map(activeFacilities.map(item => [item.label, item])).values()];
};

const campFacilities = getFacilities();

// Weather Data (Removed duplicate declaration)

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首頁",
      "item": "https://www.outdoorcampingworld.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": camp.city,
      "item": `https://www.outdoorcampingworld.com/city/${camp.city}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": camp.name,
      "item": `https://www.outdoorcampingworld.com/camp/${camp.name}`
    }
  ]
};

// 🟢 [Data-Driven] 由真實資料計算的「營地速覽」資訊 (取代模板 prose)
const campDaily = (weatherData[camp.name]?.daily) || [];
const climate = getClimateBand(camp.elevation);
const bestMonths = getBestMonthsSummary(camp);
const campSeasons = getSeasons(camp);
const distInfo = getDistanceToCityCenter(camp);
const campWeatherSummary = summarizeCampWeather(campDaily);
const dataUpdatedAt = (weatherData["_metadata"]?.generated_at || camp.release_date || '').slice(0, 10);

// 🟢 [Data-Driven FAQ] 只用「資料可佐證」的問答,並在頁面上可見渲染(修正過去隱形 schema 問題)
const campFaqItems: { q: string; a: string }[] = [];
campFaqItems.push({
    q: `${camp.name}的海拔多高？氣候如何？`,
    a: `${camp.name}位於海拔 ${camp.elevation} 公尺，屬${climate.label}。${climate.desc}`,
});
if (bestMonths) {
    const reasons = campSeasons.map(s => s.reason).join('');
    campFaqItems.push({
        q: `什麼季節去${camp.name}最合適？`,
        a: `依營區特色,推薦造訪季節為${bestMonths}。${reasons}`,
    });
}
if (campWeatherSummary) {
    campFaqItems.push({
        q: `最近${camp.name}的天氣如何？`,
        a: `${campWeatherSummary}（天氣資料每日自動更新，最後更新：${dataUpdatedAt}）`,
    });
}
if (distInfo) {
    campFaqItems.push({
        q: `${camp.name}距離市區多遠？怎麼去？`,
        a: `${camp.name}距${distInfo.centerName}直線距離約 ${distInfo.km} 公里，實際車程依山路路況而定。頁面上方地圖可直接開啟 Google 導航。`,
    });
}
if (camp.features.pet_friendly) {
    campFaqItems.push({
        q: `${camp.name}可以帶寵物嗎？`,
        a: `可以，${camp.name}為寵物友善營區，歡迎攜帶毛小孩同行（實際規定請以營區公告為準）。`,
    });
}

// FAQ Schema (與可見內容完全一致)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": campFaqItems.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

// 🟢 [SEO] Optimized Page Title Logic
// Format: [Name] - [City][Area] | [Feature1], [Feature2] | [Year]最新路況
const currentYear = new Date().getFullYear();
const featureList = [];
if (camp.features.high_altitude) featureList.push(`海拔${camp.elevation}m`);
if (camp.features.has_glamping) featureList.push("豪華露營");
if (camp.features.pet_friendly) featureList.push("寵物友善");
if (camp.tags.includes("雲海")) featureList.push("雲海");
if (camp.tags.includes("櫻花")) featureList.push("櫻花季");

// Add generic tags if we don't have enough features
if (featureList.length < 2 && camp.tags.length > 0) {
    featureList.push(camp.tags[0]);
}

const seoTitleFeatures = featureList.slice(0, 3).join('、');
const seoTitle = `${camp.name} - ${camp.city}${camp.area} | ${seoTitleFeatures} | ${currentYear}最新路況`;

// 🟢 [Data-Driven] Meta / Schema 描述
// 舊版用「3 選 1 隨機開場 + 通用堆疊句 + 關鍵字塞入」造成全站同構(Google scaled-content 風險)。
// 改為:真實 AI 描述(每頁本就不同) + 一句「真實資料事實」(氣候/季節/距離)。不再隨機、不再堆疊套語。
const dataFactParts: string[] = [climate.desc];
if (bestMonths) dataFactParts.push(`推薦造訪季節:${bestMonths}。`);
if (distInfo) dataFactParts.push(`距${distInfo.centerName}約 ${distInfo.km} 公里。`);
const dataFactSentence = dataFactParts.join('');

// Meta description:真實描述前段 + 海拔氣候(自然、不塞關鍵字)
let metaDesc = `${camp.city}${camp.area}【${camp.name}】海拔${camp.elevation}m,${climate.label}。${camp.description.replace(/\s+/g, '')}`;
if (metaDesc.length > 155) {
    metaDesc = metaDesc.substring(0, 152) + '...';
}

// Schema/頁面用的較長描述:真實描述 + 真實資料事實句
const richDescription = `${camp.description} ${dataFactSentence}`;

// 🟢 [Social SEO] Define Share Image
// 策略優先級 (Fallback Strategy):
// 1. 營區專屬圖片 (若資料庫 camp.image 欄位有值)
// 2. Unsplash 隨機情境圖 (根據 tags 自動產生，解決無圖的空窗期)
// 3. 若以上皆無 (設為 undefined)，Layout 元件會自動退回使用全站預設圖 (/social-card.webp)
// const randomCover = `https://source.unsplash.com/800x600/?camping,${camp.tags.includes('豪華露營') ? 'glamping' : 'tent'}`;
const shareImage = camp.image;
// 若您希望「沒有專屬圖就直接顯示全站預設圖(不要隨機圖)」，請改為: const shareImage = camp.image;

const schemaData = {
  "@type": "Campground",
  "name": camp.name,
  "description": richDescription,
  // 🟢 [SEO] Add explicit image property (Google Requirement for LocalBusiness)
  "image": [
    shareImage
  ],
  "telephone": camp.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": camp.address,
    "addressLocality": camp.area,
    "addressRegion": camp.city,
    "addressCountry": "TW"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": camp.lat,
    "longitude": camp.lng,
    "elevation": camp.elevation
  },
  "priceRange": "$$"
};

// 🟢 [SEO] Consolidated Graph Schema
// Combining Campground, Breadcrumb, and FAQ into one graph for better entity relation understanding by Google
const schemas = {
  "@context": "https://schema.org",
  "@graph": [
     schemaData,
     {
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "首頁", "item": "https://www.outdoorcampingworld.com" },
            { "@type": "ListItem", "position": 2, "name": camp.city, "item": `https://www.outdoorcampingworld.com/city/${camp.city}` },
            { "@type": "ListItem", "position": 3, "name": camp.name, "item": `https://www.outdoorcampingworld.com/camp/${camp.name}` }
        ]
     },
     faqSchema
  ]
};

// 🟢 [SEO] Internal Linking: Nearby Campgrounds (Haversine Distance)
function getDistance(lat1, lon1, lat2, lon2) {
  const R = 6371; // Radius of the earth in km
  const dLat = deg2rad(lat2 - lat1);
  const dLon = deg2rad(lon2 - lon1); 
  const a = 
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(deg2rad(lat1)) * Math.cos(deg2rad(lat2)) * 
    Math.sin(dLon / 2) * Math.sin(dLon / 2); 
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); 
  const d = R * c; // Distance in km
  return d;
}

function deg2rad(deg) {
  return deg * (Math.PI/180);
}

// Calculate distance for all camps (excluding current)
const nearbyCamps = campgrounds
    .filter(c => c.name !== camp.name && c.lat && c.lng)
    .map(c => ({
        ...c,
        distance: getDistance(camp.lat, camp.lng, c.lat, c.lng)
    }))
    .sort((a, b) => a.distance - b.distance)
    .slice(0, 6); // Take top 5 closest (6 to fill grid neatly if needed)

const relatedCamps = nearbyCamps;

// 🟢 [SEO] In-text Keyword Linking
// Automatically link City and Area keywords to their respective pages to boost internal link structure.
function autoLinkKeywords(text, city, area) {
    if (!text) return "";
    let linkedText = text;

    // Link City (only first occurrence to avoid spam)
    const cityRegex = new RegExp(city, "i"); // Case insensitive
    if (city && cityRegex.test(linkedText)) {
        linkedText = linkedText.replace(cityRegex, `<a href="/city/${city}" class="text-emerald-600 hover:underline font-bold">${city}</a>`);
    }

    // Link Area (only first occurrence)
    // Avoid double linking if Area contains City string (unlikely in TW data but safe to be careful)
    const areaRegex = new RegExp(area, "i");
    if (area && area !== city && areaRegex.test(linkedText)) {
         linkedText = linkedText.replace(areaRegex, `<span class="font-bold text-stone-700">${area}</span>`);
    }

    return linkedText;
}

const linkedDescription = autoLinkKeywords(camp.description, camp.city, camp.area);

// 🟢 [SEO] Reverse Silo: Compute which topic pages this camp belongs to
// This creates bidirectional links between camp detail and topic hub pages
const activeTopics = [];
if (camp.features.has_glamping) activeTopics.push({ slug: 'glamping', label: '✨ 豪華露營', desc: '免搭帳、星級體驗' });
if (camp.features.high_altitude) activeTopics.push({ slug: 'high-altitude', label: '⛰️ 高海拔避暑', desc: '雲海、星空、涼爽' });
if (camp.features.pet_friendly) activeTopics.push({ slug: 'pet-friendly', label: '🐾 寵物友善', desc: '帶著毛小孩一起' });
if (camp.tags.some(t => t.includes('森林') || t.includes('樹林'))) activeTopics.push({ slug: 'forest', label: '🌲 森林系露營', desc: '芬多精療癒' });

// City × Feature combo topics (programmatic SEO pages)
const citySlugMap: Record<string, string> = {
  '苗栗縣': 'miaoli', '新竹縣': 'hsinchu', '南投縣': 'nantou', '宜蘭縣': 'yilan',
  '台中市': 'taichung', '桃園市': 'taoyuan', '新北市': 'new-taipei', '嘉義縣': 'chiayi',
  '高雄市': 'kaohsiung', '屏東縣': 'pingtung', '花蓮縣': 'hualien', '台東縣': 'taitung'
};
const citySlug = citySlugMap[camp.city];
if (citySlug) {
  if (camp.features.has_glamping) activeTopics.push({ slug: `${citySlug}-glamping`, label: `${camp.city}豪華露營`, desc: '' });
  if (camp.features.high_altitude) activeTopics.push({ slug: `${citySlug}-high-altitude`, label: `${camp.city}高海拔`, desc: '' });
  if (camp.features.pet_friendly) activeTopics.push({ slug: `${citySlug}-pet-friendly`, label: `${camp.city}寵物友善`, desc: '' });
}

// 🟢 [T6.3] 內部連結:連到相關「資料資產」清單頁(強化 Hub & Spoke + 導流新 guide 頁)
const relevantGuides: { href: string; label: string }[] = [];
if (camp.features.high_altitude) relevantGuides.push({ href: '/guide/high-altitude-ranking/', label: '⛰️ 全台高海拔排行榜' });
if (camp.tags.some(t => t.includes('螢火蟲'))) relevantGuides.push({ href: '/guide/firefly/', label: '✨ 全台賞螢營區清單' });
if (camp.tags.some(t => t.includes('櫻花'))) relevantGuides.push({ href: '/guide/sakura/', label: '🌸 全台櫻花營區清單' });
if (camp.tags.some(t => t.includes('雲海'))) relevantGuides.push({ href: '/guide/cloud-sea/', label: '☁️ 全台雲海營區清單' });
---

<Layout title={seoTitle} description={metaDesc} image={shareImage} noindex={!shouldIndex}>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemas)}></script>
    
    {/* Hero Section - Mobile First Design */}
    <div class="bg-stone-100 border-b border-stone-200">
        <div class="container mx-auto px-4 py-3 text-sm text-stone-500">
            <a href="/" class="hover:text-emerald-700">首頁</a> &rsaquo; 
            <a href={`/city/${camp.city}/`} class="hover:text-emerald-700 mx-1">{camp.city}</a> &rsaquo;
            <span class="mx-1">{camp.area}</span> &rsaquo; 
            <span class="text-stone-800 font-medium">{camp.name}</span>
        </div>
    </div>

    <div class="container mx-auto px-4 py-8 md:py-12 pb-24 md:pb-12">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
            
            {/* Main Content (Left Column) */}
            <div class="lg:col-span-2">
                <header class="mb-6 md:mb-8">
                    <div class="flex flex-wrap items-center gap-3 mb-3">
                         {/* 🟢 [NEW] Today's Weather Summary Badge */}
                         {campWeather.length > 0 && (
                            <span class="inline-flex items-center gap-1.5 bg-stone-50 border border-stone-200 text-stone-700 text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                                <span>{campWeather[0].max_temp}°C</span>
                                <span class="text-stone-300">|</span>
                                <span>{campWeather[0].label}</span>
                            </span>
                        )}
                        {camp.features.high_altitude && <span class="bg-blue-600 text-white text-xs font-bold px-2 py-1 rounded">高海拔 {camp.elevation}m</span>}
                        {camp.features.has_glamping && <span class="bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded">豪華露營</span>}
                        {camp.features.pet_friendly && <span class="bg-emerald-600 text-white text-xs font-bold px-2 py-1 rounded">寵物友善</span>}
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-stone-900 mb-2">{camp.name}</h1>
                    <div class="flex items-center text-stone-600 text-sm md:text-base gap-4">
                        <span class="flex items-center gap-1"><span class="text-xl">📍</span> {camp.address}</span>
                    </div>

                    {/* 🟢 [NEW] Social Share Buttons - Viral Loop */}
                    <BaseShareButtons title={`【${camp.name}】${camp.city}${camp.area}露營區推薦`} />
                </header>

                {/* Map Component - Full width on mobile, top position */}
                <div class="bg-stone-200 rounded-2xl h-64 md:h-96 w-full mb-8 relative border border-stone-300 overflow-hidden shadow-inner group z-0">
                   <CampMap lat={camp.lat} lng={camp.lng} name={camp.name} />
                   <a href={`https://www.google.com/maps/search/?api=1&query=${camp.lat},${camp.lng}`} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-lg shadow-lg text-sm font-bold text-emerald-700 hover:bg-emerald-50 transition flex items-center gap-2 z-[400] active:scale-95">
                        <span>🧭</span> Google 導航
                   </a>
                </div>

                {/* Weather Widget (Now Visible on both mobile and desktop in main column) */}
                <div class="mb-8">
                    <WeatherWidget forecast={campWeather} city={camp.city} updatedAt={weatherMeta.generated_at} />
                </div>

                {/* 🟢 [Data-Driven] 營地速覽:全部由真實資料計算 */}
                <div class="mb-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="bg-white border border-stone-200 rounded-xl p-4 shadow-sm">
                        <div class="text-xs text-stone-500 mb-1">🏔️ 海拔・氣候</div>
                        <div class="font-bold text-stone-800">{camp.elevation} m｜{climate.label}</div>
                        <p class="text-xs text-stone-500 mt-1 leading-relaxed">{climate.desc}</p>
                    </div>
                    <div class="bg-white border border-stone-200 rounded-xl p-4 shadow-sm">
                        <div class="text-xs text-stone-500 mb-1">🗓️ 最佳造訪季節</div>
                        <div class="font-bold text-stone-800">{bestMonths || '四季皆宜'}</div>
                        {campWeatherSummary && <p class="text-xs text-stone-500 mt-1 leading-relaxed">{campWeatherSummary}</p>}
                    </div>
                    <div class="bg-white border border-stone-200 rounded-xl p-4 shadow-sm">
                        <div class="text-xs text-stone-500 mb-1">📍 位置・距離</div>
                        <div class="font-bold text-stone-800">{camp.city}{camp.area}</div>
                        {distInfo && <p class="text-xs text-stone-500 mt-1 leading-relaxed">距{distInfo.centerName}直線約 {distInfo.km} 公里</p>}
                    </div>
                </div>
                {dataUpdatedAt && (
                    <p class="text-xs text-stone-400 mb-8 -mt-4">🔄 天氣與資料最後更新：{dataUpdatedAt}（每日自動更新）</p>
                )}

                {/* Description - Enhanced Typography */}
                <article class="prose prose-stone prose-lg md:prose-xl max-w-none mb-12 prose-headings:font-bold prose-p:text-stone-700 prose-a:text-emerald-600">
                    <h2 class="text-2xl font-bold text-stone-800 mb-4 border-l-4 border-emerald-500 pl-4">營區介紹</h2>
                    <p class="text-lg md:text-xl leading-relaxed text-stone-700 tracking-wide" set:html={linkedDescription}></p>
                    <div class="mt-8 flex flex-wrap gap-2 not-prose">
                        {camp.tags.map(tag => (
                            <a href={`/search?q=${tag}`} class="bg-stone-50 border border-stone-200 text-stone-600 px-3 py-1 rounded-full text-sm hover:bg-emerald-50 hover:text-emerald-700 transition">#{tag}</a>
                        ))}
                    </div>

                    {/* 🟢 [SEO] Reverse Silo: Topic Hub Links */}
                    {activeTopics.length > 0 && (
                        <div class="mt-6 not-prose">
                            <p class="text-sm text-stone-500 mb-2 font-medium">📂 此營區收錄於以下主題：</p>
                            <div class="flex flex-wrap gap-2">
                                {activeTopics.map(topic => (
                                    <a href={`/topic/${topic.slug}/`}
                                       class="inline-flex items-center gap-1.5 bg-emerald-50 border border-emerald-200 text-emerald-700 px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-emerald-100 hover:border-emerald-300 transition-colors">
                                        {topic.label}
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* 🟢 [T6.3] 相關資料清單(排行/季節)內部連結 */}
                    {relevantGuides.length > 0 && (
                        <div class="mt-4 not-prose">
                            <p class="text-sm text-stone-500 mb-2 font-medium">📊 延伸清單：</p>
                            <div class="flex flex-wrap gap-2">
                                {relevantGuides.map(g => (
                                    <a href={g.href}
                                       class="inline-flex items-center gap-1.5 bg-sky-50 border border-sky-200 text-sky-700 px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-sky-100 hover:border-sky-300 transition-colors">
                                        {g.label}
                                    </a>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* ✨ New Section: Camp Facilities & Features */}
                    {campFacilities.length > 0 && (
                        <div class="mt-10 p-6 bg-stone-50 rounded-2xl border border-stone-200">
                            <h3 class="text-xl font-bold text-stone-800 mb-4 flex items-center gap-2">
                                <span>🏕️</span> 營區特色與設備
                            </h3>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                                {campFacilities.map(fac => (
                                    <div class="flex items-center gap-2 text-stone-700 bg-white px-3 py-2 rounded-lg border border-stone-100 shadow-sm">
                                        <span class="text-lg">{fac.icon}</span>
                                        <span class="font-medium">{fac.label}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </article>

                {/* 🟢 [NEW] Cross-Promo Deep Link Ad (Mobile/Tablet mid-content) */}
                <div class="block lg:hidden mb-12">
                   <NativeAdCard city={camp.city} />
                </div>

                {/* 🟢 [RESTORED] Info Cards (Old Version Style) */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
                    <div class="bg-emerald-50 p-6 rounded-xl border border-emerald-100">
                        <h3 class="font-bold text-emerald-800 mb-4 flex items-center gap-2">
                            <span>📞</span> 聯絡資訊
                        </h3>
                        <p class="text-emerald-900 font-medium text-lg mb-2">{camp.phone || "請依現場公告為主"}</p>
                        <p class="text-sm text-emerald-700">建議預訂前先致電確認營況</p>
                    </div>
                    <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
                        <h3 class="font-bold text-blue-800 mb-4 flex items-center gap-2">
                            <span>⛰️</span> 地理環境
                        </h3>
                        <div class="flex justify-between items-center border-b border-blue-200 pb-2 mb-2">
                            <span class="text-blue-700">海拔高度</span>
                            <span class="font-bold text-blue-900">{camp.elevation} 公尺</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-blue-700">所在區域</span>
                            <span class="font-bold text-blue-900">{camp.city} {camp.area}</span>
                        </div>
                    </div>
                </div>

                {/* Gear Checklist - Swapped from Sidebar */}
                <div class="border-t border-stone-200 pt-10">
                    <GearChecklist tags={camp.tags} elevation={camp.elevation} />
                </div>

                {/* 🟢 [SEO Issue] FAQ Rendering (Invisible Content Penalty Fix) */}
                <div class="bg-white p-6 rounded-xl border border-stone-200 mb-8 mt-10">
                  <h3 class="font-bold text-stone-800 mb-4 flex items-center gap-2">
                    <span>❓</span> 常見問題 Q&A
                  </h3>
                  <div class="space-y-4">
                    {faqSchema.mainEntity.map((faq) => (
                      <div class="border-b border-stone-100 last:border-0 pb-4 last:pb-0">
                        <h4 class="font-bold text-stone-700 mb-2">{faq.name}</h4>
                        <p class="text-stone-600 text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
                      </div>
                    ))}
                  </div>
                </div>
            </div>

            {/* Sidebar (Right Column) */}
             <aside class="space-y-6 lg:col-span-1">
                 {/* 🟢 [NEW] Cross-Promo Deep Link Ad (Desktop Sidebar) */}
                 <NativeAdCard city={camp.city} />

                 {/* 🟢 [RESTORED] Nearby Camps - Internal Linking (Swapped to Sidebar) */}
                 {relatedCamps.length > 0 && (
                    <div class="sticky top-24 z-10 space-y-6">
                        <div class="bg-stone-50 p-4 rounded-xl border border-stone-200">
                             <h3 class="text-lg font-bold text-stone-800 mb-4 flex items-center gap-2">
                                <span>📍</span> 推薦附近營區
                             </h3>
                             <p class="text-stone-600 mb-4 text-sm leading-relaxed">
                                如果您喜歡 {camp.name} 的風格，位於 {camp.city} 的這些鄰近營地（距離皆在 20 公里內）或許也符合您的需求。這些營地同樣擁有 {camp.tags.slice(0,2).join('、')} 等特色。
                             </p>
                             <div class="space-y-4">
                                  {relatedCamps.map(related => (
                                      <div>
                                          <CampgroundCard camp={related} />
                                      </div>
                                  ))}
                             </div>
                             <a href={`/city/${camp.city}`} class="block mt-4 text-center text-sm text-emerald-600 font-bold hover:underline py-2">
                                查看更多{camp.city}營區 &rarr;
                             </a>
                        </div>
                    </div>
                 )}
            </aside>

        </div>
    </div>


</Layout>
