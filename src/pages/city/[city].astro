---
import Layout from '../../layouts/Layout.astro';
import CampgroundCard from '../../components/CampgroundCard.astro';
import NativeAdCard from '../../components/NativeAdCard.astro';
import DataFacts from '../../components/DataFacts.astro';
import CampCompareTable from '../../components/CampCompareTable.astro';
import campgrounds from '../../data/campgrounds_smart_clean.json';
import weatherData from '../../data/weather_forecast.json';
import { getValidCampgrounds } from '../../utils/filterCamps';
import { getAdRotator } from '../../utils/adManager';
import { getElevationStats, summarizeRegionWeather, isInSeason, getSeasons } from '../../utils/campData';

export async function getStaticPaths() {
  const validCamps = getValidCampgrounds(campgrounds);
  // Ensure we only generate pages for cities that have valid camps
  const cities = [...new Set(validCamps.map((camp) => camp.city))];
  return cities.map((city) => ({
    params: { city },
    props: { city },
  }));
}

const { city } = Astro.props;
// Re-filter for run-time usage to ensure consistency
const allValidCamps = getValidCampgrounds(campgrounds);
const cityCamps = allValidCamps.filter(camp => camp.city === city);

// 🟢 [Data-Driven] 由真實資料計算 Hub 頁專屬統計
const stats = getElevationStats(cityCamps);
const weatherMap = weatherData as Record<string, any>;
const regionWeather = summarizeRegionWeather(weatherMap, cityCamps, city);
const weatherUpdatedAt = (weatherMap._metadata?.generated_at || '').slice(0, 10);

// 當月當季營區(依真實標籤 + 當月)
const currentMonth = new Date().getMonth() + 1;
const inSeasonCamps = cityCamps.filter(c => isInSeason(c, currentMonth));
// 當季主題名稱(取第一個當季營區的季節標籤,用於標題點綴)
const seasonLabels = [...new Set(cityCamps.flatMap(c => getSeasons(c).filter(s => s.months.includes(currentMonth)).map(s => s.label)))];

// Layout.astro 會自動附加 "| Outdoor Camping World 台灣站"，因此這裡不需要重複品牌名稱
const elevRange = stats.maxElev > 0 ? `海拔 ${stats.minElev}–${stats.maxElev}m` : '';
const title = `${city}露營區推薦｜${stats.count} 個精選營地${stats.highAltitude > 0 ? `，含 ${stats.highAltitude} 個高海拔避暑` : ''}`;
const description = `${city}露營區完整清單:收錄 ${stats.count} 個營地${elevRange ? `（${elevRange}）` : ''}，其中高海拔 ${stats.highAltitude} 個、豪華露營 ${stats.glamping} 個。附即時天氣、海拔比較表與地圖。`;

// 🟢 [Ad Logic]
const adRotator = getAdRotator();

// 🟢 [Thin Content Defense] Neighbor City Mapping
const neighborMap: Record<string, string> = {
    "基隆市": "新北市", "台北市": "新北市", "新北市": "桃園市", 
    "桃園市": "新竹縣", "新竹市": "新竹縣", "新竹縣": "苗栗縣",
    "苗栗縣": "台中市", "台中市": "南投縣", "彰化縣": "南投縣",
    "南投縣": "台中市", "雲林縣": "嘉義縣", "嘉義市": "嘉義縣",
    "嘉義縣": "台南市", "台南市": "高雄市", "高雄市": "屏東縣",
    "屏東縣": "高雄市", "宜蘭縣": "新北市", "花蓮縣": "台東縣",
    "台東縣": "花蓮縣", "澎湖縣": "台南市", "金門縣": "高雄市", 
    "連江縣": "基隆市"
};
const neighborCity = neighborMap[city];
const neighborCamps = (cityCamps.length < 4 && neighborCity) 
    ? campgrounds.filter(c => c.city === neighborCity).slice(0, 3) 
    : [];

// 🟢 [SEO] Link Mesh: City -> Sub-Topics (連接 pSEO 頁面)
// 必須與 topic/[id].astro 的生成邏輯保持一致
const CITY_SLUG_MAP: Record<string, string> = {
    '苗栗縣': 'miaoli', '新竹縣': 'hsinchu', '南投縣': 'nantou',
    '宜蘭縣': 'yilan', '台中市': 'taichung', '桃園市': 'taoyuan',
    '新北市': 'new-taipei', '嘉義縣': 'chiayi', '高雄市': 'kaohsiung',
    '屏東縣': 'pingtung', '花蓮縣': 'hualien', '台東縣': 'taitung'
};

const FEATURE_CONFIG = [
    { id: 'glamping', label: '豪華露營', icon: '✨', filter: (c: any) => c.features.has_glamping },
    { id: 'high-altitude', label: '高海拔', icon: '⛰️', filter: (c: any) => c.features.high_altitude },
    { id: 'pet-friendly', label: '寵物友善', icon: '🐾', filter: (c: any) => c.features.pet_friendly },
    { id: 'forest', label: '森林系', icon: '🌲', filter: (c: any) => c.tags.some((t: string) => t.includes('森林') || t.includes('樹林')) },
];

// 計算該城市有哪些 pSEO 子主題是有效的 (數量 >= 3)
const availableTopics = FEATURE_CONFIG.map(feat => {
    const count = cityCamps.filter(feat.filter).length;
    return {
        ...feat,
        count,
        href: `/topic/${CITY_SLUG_MAP[city]}-${feat.id}/`
    };
}).filter(t => t.count >= 3 && CITY_SLUG_MAP[city]); // 確保有對應的 slug 且數量足夠

// 🟢 [Data-Driven FAQ] 只用真實資料佐證的問答(可見 + schema 一致)
const highestCamp = [...cityCamps].sort((a, b) => (b.elevation ?? 0) - (a.elevation ?? 0))[0];
const faqItems: { q: string; a: string }[] = [];
faqItems.push({
  q: `${city}有幾個露營區可以選擇？`,
  a: `本站目前收錄 ${city} 共 ${stats.count} 個露營區，海拔範圍從 ${stats.minElev} 到 ${stats.maxElev} 公尺，涵蓋高海拔避暑、豪華露營、森林系等不同類型。`,
});
if (stats.highAltitude > 0 && highestCamp) {
  faqItems.push({
    q: `${city}有適合夏天避暑的高海拔露營區嗎？`,
    a: `有的，${city} 有 ${stats.highAltitude} 個海拔 1000 公尺以上的高海拔營區，其中海拔最高的是「${highestCamp.name}」（海拔 ${highestCamp.elevation} 公尺），夏季明顯比平地涼爽。`,
  });
}
if (stats.glamping > 0) {
  faqItems.push({
    q: `${city}有免搭帳的豪華露營（Glamping）嗎？`,
    a: `${city} 有 ${stats.glamping} 個提供豪華露營的營區，免自備裝備即可入住，適合露營新手與親子家庭。`,
  });
}
if (regionWeather) {
  faqItems.push({
    q: `最近去${city}露營，天氣如何？`,
    a: `${regionWeather}（天氣資料每日更新，最後更新：${weatherUpdatedAt}）`,
  });
}

// 🟢 [SEO] City Page Schemas (CollectionPage + Breadcrumb + FAQ)
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "首頁", "item": Astro.site },
        { "@type": "ListItem", "position": 2, "name": city, "item": Astro.url.href }
      ]
    },
    {
      "@type": "CollectionPage",
      "name": `${city}露營區推薦`,
      "description": description,
      "url": Astro.url.href,
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": cityCamps.slice(0, 15).map((camp, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": new URL(`/camp/${camp.name}/`, Astro.site).toString(),
          "name": camp.name
        }))
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqItems.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

---

<Layout title={title} description={description}>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)}></script>

    <div class="bg-stone-100 border-b border-stone-200">
        <div class="container mx-auto px-4 py-3 text-sm text-stone-500">
            <a href="/" class="hover:text-emerald-700">首頁</a> &rsaquo; 
            <span class="text-stone-800 font-medium">{city}</span>
        </div>
    </div>

    <div class="container mx-auto px-4 py-12">
        <header class="mb-8 text-center">
            <h1 class="text-3xl md:text-4xl font-extrabold text-stone-900 mb-4">{city} 露營區推薦</h1>
            <p class="text-lg text-stone-600 max-w-2xl mx-auto mb-8">
                本站收錄 {city} 共 <strong class="text-emerald-700">{stats.count}</strong> 個露營地，
                {stats.maxElev > 0 && <>海拔從 {stats.minElev} 到 {stats.maxElev} 公尺，</>}
                其中高海拔避暑 {stats.highAltitude} 個、豪華露營 {stats.glamping} 個。
            </p>

            {/* 🟢 [SEO] pSEO Internal Links Hub */}
            {availableTopics.length > 0 && (
                <div class="flex flex-wrap justify-center gap-3">
                    {availableTopics.map(topic => (
                        <a href={topic.href} class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-emerald-200 rounded-full text-emerald-800 hover:bg-emerald-50 hover:border-emerald-300 transition shadow-sm font-medium">
                            <span>{topic.icon}</span>
                            <span>{city}{topic.label} ({topic.count})</span>
                        </a>
                    ))}
                </div>
            )}
        </header>

        {/* 🟢 [Data-Driven] 真實統計 + 區域天氣 */}
        <DataFacts camps={cityCamps} weatherSummary={regionWeather} />

        {/* 🟢 [Data-Driven] 當季推薦(依當月 + 真實標籤) */}
        {inSeasonCamps.length > 0 && seasonLabels.length > 0 && (
            <div class="my-8 bg-amber-50 border border-amber-200 rounded-2xl p-6">
                <h2 class="text-xl font-bold text-amber-900 mb-1 flex items-center gap-2">
                    <span>🗓️</span> {currentMonth} 月當季推薦：{seasonLabels.join('、')}
                </h2>
                <p class="text-sm text-amber-800/80 mb-4">依營區特色與當月季節自動推薦，共 {inSeasonCamps.length} 個當季營區。</p>
                <div class="flex flex-wrap gap-2">
                    {inSeasonCamps.slice(0, 12).map(c => (
                        <a href={`/camp/${c.name}/`} class="inline-block bg-white border border-amber-200 text-amber-900 px-3 py-1.5 rounded-lg text-sm font-medium hover:bg-amber-100 transition">
                            {c.name}{c.elevation ? <span class="text-amber-500 text-xs"> · {c.elevation}m</span> : null}
                        </a>
                    ))}
                </div>
            </div>
        )}

        {cityCamps.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {cityCamps.map((camp, index) => (
                    <>
                        <CampgroundCard camp={camp} />
                        {/* Insert Ad every 6 items (offset by 2) to break up the grid nicely */}
                        {index % 6 === 2 && (
                             <div class="col-span-1 h-full min-h-[380px]">
                                 <NativeAdCard adData={adRotator.next()} />
                             </div>
                        )}
                    </>
                ))}
            </div>
        ) : (
            <p class="text-center text-stone-500 py-20">目前 {city} 尚無收錄營區資料。</p>
        )}

        {/* 🟢 [Data-Driven] 海拔比較表(可排序) */}
        {cityCamps.length > 1 && (
            <div class="mt-16">
                <h2 class="text-2xl font-bold text-stone-800 mb-2">{city}露營區海拔比較表</h2>
                <p class="text-stone-500 text-sm mb-2">依海拔高低排序,快速比較 {city} 各營區的高度與特色。</p>
                <CampCompareTable camps={cityCamps} />
            </div>
        )}

        {/* 🟢 [Data-Driven] 可見 FAQ(與 schema 一致) */}
        {faqItems.length > 0 && (
            <div class="mt-16 max-w-3xl">
                <h2 class="text-2xl font-bold text-stone-800 mb-6">關於 {city} 露營，常見問題</h2>
                <div class="space-y-4">
                    {faqItems.map(f => (
                        <div class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm">
                            <h3 class="font-bold text-stone-800 mb-2">{f.q}</h3>
                            <p class="text-stone-600 leading-relaxed">{f.a}</p>
                        </div>
                    ))}
                </div>
            </div>
        )}

        {/* 🟢 [Thin Content Defense] Neighboring City Recommendations */}
        {neighborCamps.length > 0 && (
            <div class="mt-16 pt-10 border-t border-stone-200">
                <h3 class="text-xl font-bold text-stone-700 mb-6 flex items-center gap-2">
                    <span class="text-2xl">🛤️</span> 
                    {cityCamps.length === 0 ? `不妨看看鄰近的 ${neighborCity}` : `鄰近的 ${neighborCity} 還有更多選擇...`}
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 opacity-90 hover:opacity-100 transition-opacity">
                    {neighborCamps.map(camp => (
                        <CampgroundCard camp={camp} />
                    ))}
                </div>
            </div>
        )}
    </div>
</Layout>
