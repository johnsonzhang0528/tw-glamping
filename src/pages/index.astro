---
import Layout from '../layouts/Layout.astro';
import CampgroundCard from '../components/CampgroundCard.astro';
import NativeAdCard from '../components/NativeAdCard.astro';
import campgrounds from '../data/campgrounds_enriched.json';

// Simple types for the dataset
type Campground = {
	name: string;
	city: string;
	area: string;
	phone: string;
	elevation: number;
	description: string;
	tags: string[];
	features: {
		has_glamping: boolean;
		pet_friendly: boolean;
		high_altitude: boolean;
	};
};

const camps = campgrounds as Campground[];

// 🟢 動態計算熱門縣市
const cityStats = camps.reduce((acc, camp) => {
  acc[camp.city] = (acc[camp.city] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const popularCities = Object.entries(cityStats)
  .sort(([, countA], [, countB]) => countB - countA)
  .slice(0, 8)
  .map(([city, count]) => ({ city, count }));
---

<Layout 
	title="Outdoor Camping World 台灣站 | 終極露營指南 Since 2004"
    preloadImage="/hero-bg.webp"
>
    
    <div class="relative bg-stone-900 -mt-[64px] pt-[64px]">
        <div class="absolute inset-0 overflow-hidden">
            <img 
                src="/hero-bg.webp" 
                alt="Camping Background" 
                class="w-full h-full object-cover opacity-60"
                fetchpriority="high"
                loading="eager"
                width="1920"
                height="1080"
                decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-stone-50/10"></div>
        </div>

        <div class="container mx-auto px-4 py-20 md:py-32 relative z-10 text-center">
            <span class="inline-block py-1 px-3 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold tracking-wider mb-6 backdrop-blur-sm">
                SINCE 2004 • TAIWAN EDITION
            </span>
            <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight drop-shadow-lg">
                發現你的下一個<br/><span class="text-emerald-400">戶外冒險</span>
            </h1>
            <p class="text-lg md:text-xl text-stone-200 max-w-2xl mx-auto mb-10 leading-relaxed drop-shadow-md">
                收錄全台 {camps.length} 個精選露營區，結合 AI 海拔分析與氣候建議，
                <br class="hidden md:inline"/>讓每一次的紮營，都是最完美的體驗。
            </p>
            <div class="flex justify-center gap-4">
                <a href="/search" class="w-full md:w-auto bg-emerald-600 text-white px-8 py-4 rounded-xl font-bold hover:bg-emerald-500 transition shadow-lg shadow-emerald-900/50 active:scale-95 transform duration-100 inline-flex items-center justify-center gap-2">
                    <span>🔭</span> 開始探索營地
                </a>
            </div>
        </div>
    </div>

    <section class="container mx-auto px-4 -mt-16 mb-16 relative z-20">
        <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 border border-stone-100 relative group">
            
            <div class="flex justify-between items-end mb-6">
                <div>
                    <h2 class="text-sm font-bold text-stone-500 uppercase tracking-wider">熱門露營地區</h2>
                    <p class="text-2xl font-bold text-stone-800 mt-1">你想去哪裡露營？</p>
                </div>
                <a href="/search" class="hidden md:block text-emerald-600 text-sm font-bold hover:underline">查看全台地圖 &rarr;</a>
            </div>
            
            <div class="flex overflow-x-auto pb-4 gap-3 md:grid md:grid-cols-4 lg:grid-cols-6 md:overflow-visible md:pb-0 snap-x scrollbar-hide">
                {popularCities.map(({ city, count }) => (
                    <a href={`/city/${city}`} class="snap-start shrink-0 w-[140px] md:w-auto flex flex-col items-center justify-center p-4 rounded-xl bg-stone-50 hover:bg-emerald-50 hover:text-emerald-700 transition-all duration-200 group/btn border border-stone-100 hover:border-emerald-200 hover:shadow-md active:scale-95">
                        <span class="w-8 h-8 rounded-full bg-white text-lg flex items-center justify-center mb-2 shadow-sm group-hover/btn:scale-110 transition-transform">📍</span>
                        <span class="font-bold text-stone-800 group-hover/btn:text-emerald-700">{city}</span>
                        <span class="text-xs text-stone-500 mt-1">{count} 個營區</span>
                    </a>
                ))}
            </div>

            <div class="absolute right-0 top-20 bottom-20 w-8 bg-gradient-to-l from-white to-transparent pointer-events-none md:hidden"></div>
            
            <div class="mt-4 md:hidden text-center border-t border-stone-100 pt-4">
                 <a href="/search" class="text-emerald-600 text-sm font-bold flex items-center justify-center gap-1 active:opacity-70">
                    查看全台地圖 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                 </a>
            </div>
        </div>
    </section>

    <div class="container mx-auto px-4 pb-12">
		<section class="pb-8">
			<div class="flex items-center justify-between mb-6 md:mb-8">
				<h2 class="text-xl md:text-2xl font-bold text-stone-800 flex items-center gap-2">
                    <span>🔥</span> 熱門精選營區
                </h2>
				<a href="/search" class="text-emerald-600 font-medium hover:underline text-sm md:text-base">查看全部 &rarr;</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
				{camps.slice(0, 9).map((camp, index) => (
					<>
						<CampgroundCard camp={camp} />
						{/* Insert Native Ad every 6th item (index 5) */}
						{index === 5 && <NativeAdCard />}
					</>
				))}
			</div>
		</section>
	</div>
</Layout>
