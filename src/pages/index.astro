---
import Layout from '../layouts/Layout.astro';
import CampgroundCard from '../components/CampgroundCard.astro';
import NativeAdCard from '../components/NativeAdCard.astro';
import campgrounds from '../data/campgrounds_enriched.json';

// Simple types for the dataset
type Campground = {
	name: string;
	city: string;
	area: string;
	phone: string;
	elevation: number;
	description: string;
	tags: string[];
	features: {
		has_glamping: boolean;
		pet_friendly: boolean;
		high_altitude: boolean;
	};
};

const camps = campgrounds as Campground[];
---

<Layout title="Outdoor Camping World 台灣站 | 終極露營指南 Since 2004">
	<div class="container mx-auto px-4 py-8 md:py-12">
		<section class="text-center mb-10 md:mb-16">
			<h1 class="text-3xl md:text-5xl font-extrabold text-stone-900 mb-4 md:mb-6 tracking-tight">
				發現你的下一個<br/><span class="text-emerald-600">戶外冒險</span>
			</h1>
			<p class="text-base md:text-lg text-stone-600 max-w-2xl mx-auto mb-8">
				收錄全台 {camps.length} 個精選露營區，即時海拔資訊、特色標籤篩選，
				<br class="hidden md:inline"/>讓找營位變得前所未有的簡單。
			</p>
			<div class="flex justify-center gap-4">
				<button class="w-full md:w-auto bg-emerald-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-emerald-700 transition shadow-lg shadow-emerald-600/20 active:scale-95 transform duration-100">
					開始探索
				</button>
			</div>
		</section>

		<section class="pb-8">
			<div class="flex items-center justify-between mb-6 md:mb-8">
				<h2 class="text-xl md:text-2xl font-bold text-stone-800">熱門精選營區</h2>
				<a href="/search" class="text-emerald-600 font-medium hover:underline text-sm md:text-base">查看全部 &rarr;</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
				{camps.slice(0, 9).map((camp, index) => (
					<>
						<CampgroundCard camp={camp} />
						{/* Insert Native Ad every 6th item (index 5) */}
						{index === 5 && <NativeAdCard />}
					</>
				))}
			</div>
		</section>
	</div>
</Layout>
</Layout>
