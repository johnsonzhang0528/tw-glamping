---
import Layout from '../layouts/Layout.astro';
import CampgroundCard from '../components/CampgroundCard.astro';
import FilterBar from '../components/FilterBar.astro';
import campgrounds from '../data/campgrounds_enriched.json';

// Get unique cities for filter dropdown
const cities = [...new Set(campgrounds.map(c => c.city))].sort();

// Simple types for the dataset
type Campground = {
	name: string;
	city: string;
	area: string;
	description: string;
	tags: string[];
    elevation: number;
	features: {
		has_glamping: boolean;
		pet_friendly: boolean;
		high_altitude: boolean;
	};
};
---

<Layout title="全台露營區搜尋 | 台灣露營地圖">
	<FilterBar />
	<div class="bg-stone-100 py-6 md:py-12 border-b border-stone-200">
		<div class="container mx-auto px-4">
			<h1 class="text-2xl md:text-3xl font-bold text-stone-900 mb-4 md:mb-6 text-center">尋找理想營區</h1>
			
			<div class="max-w-4xl mx-auto bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-stone-200" id="search-controls">
				<div class="grid grid-cols-1 md:grid-cols-12 gap-4">
					{/* Search Input */}
					<div class="md:col-span-12">
						<label class="block text-sm font-semibold text-stone-700 mb-1">關鍵字搜尋</label>
						<input 
							type="text" 
							id="search-input" 
							placeholder="輸入營區名稱、地區 (例如: 苗栗、五峰)..." 
							class="w-full px-4 py-3 rounded-lg border border-stone-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
						/>
					</div>

                    {/* Advanced Filters Row */}
                    <div class="md:col-span-12 grid grid-cols-2 md:grid-cols-4 gap-4">
                        {/* City Filter */}
                        <div>
                            <label class="block text-xs font-bold text-stone-500 mb-1">區域縣市</label>
                            <select id="filter-city" class="w-full px-3 py-2 rounded-lg border border-stone-300 text-stone-700 text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-stone-50">
                                <option value="">所有縣市</option>
                                {cities.map(city => (
                                    <option value={city}>{city}</option>
                                ))}
                            </select>
                        </div>
                        
                        {/* Sort Order */}
                        <div>
                            <label class="block text-xs font-bold text-stone-500 mb-1">排序方式</label>
                            <select id="sort-order" class="w-full px-3 py-2 rounded-lg border border-stone-300 text-stone-700 text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-stone-50">
                                <option value="default">預設排序</option>
                                <option value="elevation-desc">海拔：由高到低</option>
                                <option value="elevation-asc">海拔：由低到高</option>
                            </select>
                        </div>

                         {/* Checkbox Group - Took up remaining space */}
                         <div class="col-span-2 flex flex-wrap gap-2 items-end">
                            <label class="flex items-center gap-2 cursor-pointer bg-stone-50 px-3 py-2 rounded-lg border border-stone-200 hover:bg-stone-100 transition select-none flex-grow justify-center">
                                <input type="checkbox" id="filter-high-altitude" class="w-4 h-4 text-emerald-600 rounded focus:ring-emerald-500" />
                                <span class="text-sm font-medium text-stone-700">高海拔</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer bg-stone-50 px-3 py-2 rounded-lg border border-stone-200 hover:bg-stone-100 transition select-none flex-grow justify-center">
                                <input type="checkbox" id="filter-glamping" class="w-4 h-4 text-emerald-600 rounded focus:ring-emerald-500" />
                                <span class="text-sm font-medium text-stone-700">豪華露營</span>
                            </label>
                             <label class="flex items-center gap-2 cursor-pointer bg-stone-50 px-3 py-2 rounded-lg border border-stone-200 hover:bg-stone-100 transition select-none flex-grow justify-center">
                                <input type="checkbox" id="filter-pet" class="w-4 h-4 text-emerald-600 rounded focus:ring-emerald-500" />
                                <span class="text-sm font-medium text-stone-700">寵物友善</span>
                            </label>
                        </div>
                    </div>
				</div>
                
                <div class="mt-4 flex justify-between items-center text-xs text-stone-500">
                    <button id="clear-filters" class="text-emerald-600 hover:underline hidden">清除所有條件</button>
                    <span>顯示 <span id="count-display" class="font-bold text-stone-800">{campgrounds.length}</span> 筆結果</span>
                </div>
			</div>
		</div>
	</div>

	<div class="container mx-auto px-4 py-12">
		<div id="results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
			{campgrounds.map((camp) => (
				<div 
                    class="camp-item opacity-100 transition-opacity duration-300"
                    data-name={camp.name.toLowerCase()}
                    data-city={camp.city}
                    data-area={camp.area}
                    data-tags={camp.tags.join(',')}
                    data-elevation={camp.elevation}
                    data-high-altitude={camp.features.high_altitude}
                    data-glamping={camp.features.has_glamping}
                    data-pet={camp.features.pet_friendly}
                >
					<CampgroundCard camp={camp as Campground} />
				</div>
			))}
		</div>

        {/* No Results Message */}
        <div id="no-results" class="hidden text-center py-20">
            <div class="text-6xl mb-4">🔍</div>
            <h3 class="text-xl font-bold text-stone-800 mb-2">找不到符合條件的營區</h3>
            <p class="text-stone-500">試著減少篩選條件，或搜尋其他關鍵字</p>
        </div>
	</div>
</Layout>

<script>
    // Client-side filtering logic
    const searchInputEl = document.getElementById('search-input') as HTMLInputElement;
    const filterHighAltEl = document.getElementById('filter-high-altitude') as HTMLInputElement;
    const filterGlampingEl = document.getElementById('filter-glamping') as HTMLInputElement;
    // ...existing code...
    // Variables that need to be refreshed on page navigation
    let searchInput: HTMLInputElement;
    let filterCity: HTMLSelectElement;
    let sortOrder: HTMLSelectElement;
    let filterHighAlt: HTMLInputElement;
    let filterGlamping: HTMLInputElement;
    let filterPet: HTMLInputElement;
    let clearBtn: HTMLElement | null;
    let resultsGrid: HTMLElement | null;
    let noResults: HTMLElement | null;
    let countDisplay: HTMLElement | null;
    let items: NodeListOf<Element>;

    // Parse URL URLSearchParameters to autofill search
    function initFromURL() {
        const params = new URLSearchParams(window.location.search);
        const query = params.get('q');
        const city = params.get('city');
        const tag = params.get('tag');

        if (query && searchInput) searchInput.value = query;
        if (city && filterCity) filterCity.value = city;
        
        // Handle Tag shortcuts from FilterBar
        if (tag) {
            if (tag === 'High Altitude' && filterHighAlt) filterHighAlt.checked = true;
            if (tag === 'Glamping' && filterGlamping) filterGlamping.checked = true;
            // Add more mappings if needed
        }

        filterCamps();
    }

    function sortCamps() {
        if (!resultsGrid || !sortOrder) return;
        const order = sortOrder.value;
        const itemArray = Array.from(items) as HTMLElement[];

        if (order === 'default') {
             // Basic randomized or original sort (could implement shuffle if needed)
             // For now we just revert to DOM order if possible, or just leave as is
             // Better implementation: keep original index in data attribute if strict reset needed
             itemArray.sort((a, b) => {
                 return (a.dataset.name || '').localeCompare(b.dataset.name || '');
             });
        } else if (order === 'elevation-desc') {
            itemArray.sort((a, b) => {
                return Number(b.dataset.elevation) - Number(a.dataset.elevation);
            });
        } else if (order === 'elevation-asc') {
            itemArray.sort((a, b) => {
                return Number(a.dataset.elevation) - Number(b.dataset.elevation);
            });
        }

        // Re-append to grid
        itemArray.forEach(item => resultsGrid?.appendChild(item));
    }

    function filterCamps() {
        if (!searchInput) return;
        
        const term = searchInput.value.toLowerCase();
        const cityFilter = filterCity?.value || '';
        const requireHighAlt = filterHighAlt?.checked || false;
        const requireGlamping = filterGlamping?.checked || false;
        const requirePet = filterPet?.checked || false;

        // Show/Hide Clear Button
        const hasFilters = term || cityFilter || requireHighAlt || requireGlamping || requirePet;
        if (clearBtn) clearBtn.classList.toggle('hidden', !hasFilters);

        let visibleCount = 0;

        items.forEach((item) => {
            const el = item as HTMLElement;
            const name = el.dataset.name || '';
            const city = el.dataset.city || '';
            const area = el.dataset.area || '';
            const tags = el.dataset.tags || '';
            
            const isHighAlt = el.dataset.highAltitude === 'true';
            const isGlamping = el.dataset.glamping === 'true';
            const isPet = el.dataset.pet === 'true';

            // Check Matches
            let matchesSearch = term === '' || 
                                  name.includes(term) || 
                                  city.includes(term) || 
                                  area.includes(term) ||
                                  tags.includes(term);
            
            // City Match
            const matchesCity = cityFilter === '' || city === cityFilter;

            // Special keyword mapping for features (ensures FilterBar works for features not in tags)
            if (!matchesSearch) {
                if (term.includes('豪華') && isGlamping) matchesSearch = true;
                if (term.includes('高海拔') && isHighAlt) matchesSearch = true;
                if (term.includes('寵物') && isPet) matchesSearch = true;
            }
            
            const matchesFilters = (!requireHighAlt || isHighAlt) &&
                                   (!requireGlamping || isGlamping) &&
                                   (!requirePet || isPet);

            if (matchesSearch && matchesCity && matchesFilters) {
                el.style.display = 'block';
                visibleCount++;
            } else {
                el.style.display = 'none';
            }
        });

        // Update UI State
        if (countDisplay) countDisplay.textContent = visibleCount.toString();
        
        if (visibleCount === 0) {
            resultsGrid?.classList.add('hidden');
            noResults?.classList.remove('hidden');
        } else {
            resultsGrid?.classList.remove('hidden');
            noResults?.classList.add('hidden');
            sortCamps(); // Re-sort visible items
        }
    }

    function clearFilters() {
        if(searchInput) searchInput.value = '';
        if(filterCity) filterCity.value = '';
        if(filterHighAlt) filterHighAlt.checked = false;
        if(filterGlamping) filterGlamping.checked = false;
        if(filterPet) filterPet.checked = false;
        if(sortOrder) sortOrder.value = 'default';
        filterCamps();
    }

    // Debounce for better performance
    let debounceTimer: ReturnType<typeof setTimeout>;
    function handleInput() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(filterCamps, 150);
    }

    // Main initialization function
    function init() {
         // Re-query DOM elements because they might be new after a transition
        searchInput = document.getElementById('search-input') as HTMLInputElement;
        filterCity = document.getElementById('filter-city') as HTMLSelectElement;
        sortOrder = document.getElementById('sort-order') as HTMLSelectElement;
        
        filterHighAlt = document.getElementById('filter-high-altitude') as HTMLInputElement;
        filterGlamping = document.getElementById('filter-glamping') as HTMLInputElement;
        filterPet = document.getElementById('filter-pet') as HTMLInputElement;
        
        clearBtn = document.getElementById('clear-filters');
        resultsGrid = document.getElementById('results-grid');
        noResults = document.getElementById('no-results');
        countDisplay = document.getElementById('count-display');
        items = document.querySelectorAll('.camp-item');

        // Attach listeners again
        if (searchInput) searchInput.addEventListener('input', handleInput);
        if (filterCity) filterCity.addEventListener('change', filterCamps);
        if (sortOrder) sortOrder.addEventListener('change', sortCamps);
        
        if (filterHighAlt) filterHighAlt.addEventListener('change', filterCamps);
        if (filterGlamping) filterGlamping.addEventListener('change', filterCamps);
        if (filterPet) filterPet.addEventListener('change', filterCamps);
        
        if (clearBtn) clearBtn.addEventListener('click', clearFilters);

        initFromURL();
    }
    
    // Astro View Transitions Events
    // Runs on initial load AND after every navigation
    document.addEventListener('astro:page-load', init);
</script>
