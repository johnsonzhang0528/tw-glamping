---
import Layout from '../layouts/Layout.astro';
import CampgroundCard from '../components/CampgroundCard.astro';
import campgrounds from '../data/campgrounds_enriched.json';

// Get unique cities for filter dropdown
const cities = [...new Set(campgrounds.map(c => c.city))].sort();

// Simple types for the dataset
type Campground = {
	name: string;
	city: string;
	area: string;
	description: string;
	tags: string[];
    elevation: number;
	features: {
		has_glamping: boolean;
		pet_friendly: boolean;
		high_altitude: boolean;
	};
};

// Define grouped filters
const filterGroups = [
    {
        title: '地區與位置',
        icon: '📍',
        items: [
            { label: '苗栗', key: '苗栗', type: 'location' },
            { label: '新竹', key: '新竹', type: 'location' },
            { label: '南投', key: '南投', type: 'location' },
            { label: '五峰', key: '五峰', type: 'location' },
            { label: '泰安', key: '泰安', type: 'location' },
            { label: '尖石', key: '尖石', type: 'location' },
            { label: '阿里山', key: '阿里山', type: 'location' },
        ]
    },
    {
        title: '自然景觀',
        icon: '🌲',
        items: [
            { id: 'filter-high-altitude', label: '高海拔', icon: '⛰️', type: 'feature', key: 'high_altitude' }, // Kept existing feature
            { label: '雲海', key: '雲海', type: 'tag' },
            { label: '螢火蟲', key: '螢火蟲', type: 'tag' },
            { label: '櫻花', key: '櫻花', type: 'tag' },
            { label: '夜景', key: '夜景', type: 'tag' },
            { label: '溪流', key: '溪流', type: 'tag' },
            { label: '森林系', key: '森林系', type: 'tag' },
            { label: '落羽松', key: '落羽松', type: 'tag' },
        ]
    },
    {
        title: '營地設施',
        icon: '⛺',
        items: [
            { id: 'filter-glamping', label: '豪華露營', icon: '✨', type: 'feature', key: 'glamping' }, // Kept existing feature
            { label: '有冰箱', key: '有冰箱/冰箱', type: 'tag' }, // Handle slight variations if needed
            { label: '有冷凍', key: '有冷凍', type: 'tag' },
            { label: '飲水機', key: '飲水機', type: 'tag' },
            { label: '提供電源', key: '提供電源', type: 'tag' },
            { label: '吹風機', key: '吹風機', type: 'tag' },
            { label: '雨棚', key: '雨棚', type: 'tag' },
            { label: '室內營位', key: '室內營位', type: 'tag' },
            { label: '包區', key: '包區', type: 'tag' },
            { label: '小包區', key: '小包區', type: 'tag' },
            { label: '少帳包區', key: '少帳包區', type: 'tag' },
            { label: '車露', key: '車露', type: 'tag' },
            { label: '可停露營拖車', key: '可停露營拖車', type: 'tag' },
            { label: '部份區域可車露', key: '部份區域可車露', type: 'tag' },
        ]
    },
    {
        title: '親子與活動',
        icon: '👨‍👩‍👧‍👦',
        items: [
            { id: 'filter-pet', label: '寵物友善', icon: '🐾', type: 'feature', key: 'pet_friendly' }, // Kept existing feature
            { label: '親子', key: '親子', type: 'tag' },
            { label: '沙坑', key: '沙坑', type: 'tag' },
            { label: '戲水池', key: '戲水池', type: 'tag' },
            { label: '溜滑梯', key: '溜滑梯', type: 'tag' },
            { label: '烤肉', key: '烤肉', type: 'tag' },
        ]
    },
    {
        title: '便利性',
        icon: '📶',
        items: [
            { label: 'WIFI', key: 'WIFI', type: 'tag' },
            { label: '3G/4G訊號', key: '3G/4G訊號', type: 'tag' },
            { label: '裝備租借', key: '裝備租借', type: 'tag' },
        ]
    }
];
---

<Layout title="全台露營區搜尋 | 台灣露營地圖">
	<div class="bg-stone-100 py-6 md:py-12 border-b border-stone-200">
		<div class="container mx-auto px-4">
			<h1 class="text-2xl md:text-3xl font-bold text-stone-900 mb-4 md:mb-6 text-center">尋找理想營區</h1>
			
			<div class="max-w-4xl mx-auto bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-stone-200" id="search-controls">
				<div class="grid grid-cols-1 md:grid-cols-12 gap-4">
					{/* Search Input */}
					<div class="md:col-span-12">
						<label class="block text-sm font-semibold text-stone-700 mb-1">關鍵字搜尋</label>
						<input 
							type="text" 
							id="search-input" 
							placeholder="輸入營區名稱、地區 (例如: 苗栗、五峰)..." 
							class="w-full px-4 py-3 rounded-lg border border-stone-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
						/>
					</div>

                    {/* Advanced Filters Row */}
                    <div class="md:col-span-12 grid grid-cols-2 md:grid-cols-4 gap-4">
                        {/* City Filter */}
                        <div>
                            <label class="block text-xs font-bold text-stone-500 mb-1">區域縣市</label>
                            <select id="filter-city" class="w-full px-3 py-2 rounded-lg border border-stone-300 text-stone-700 text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-stone-50">
                                <option value="">所有縣市</option>
                                {cities.map(city => (
                                    <option value={city}>{city}</option>
                                ))}
                            </select>
                        </div>
                        
                        {/* Sort Order */}
                        <div>
                            <label class="block text-xs font-bold text-stone-500 mb-1">排序方式</label>
                            <select id="sort-order" class="w-full px-3 py-2 rounded-lg border border-stone-300 text-stone-700 text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-stone-50">
                                <option value="default">預設排序</option>
                                <option value="elevation-desc">海拔：由高到低</option>
                                <option value="elevation-asc">海拔：由低到高</option>
                            </select>
                        </div>
                    </div>

                    {/* Collapse Button */}
                    <div class="md:col-span-12">
                        <button 
                            id="toggle-advanced-filters" 
                            class="flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition"
                        >
                            <span id="toggle-icon">▶</span>
                            進階篩選條件
                        </button>
                    </div>

                    {/* Advanced Filters Groups (Collapsible) */}
                    <div id="advanced-filters-panel" class="hidden md:col-span-12 mt-4 space-y-6 pt-4 border-t border-stone-100">
                        {filterGroups.map(group => (
                            <div>
                                <h3 class="flex items-center gap-2 text-sm font-bold text-stone-600 mb-3 pb-1 border-b border-stone-100">
                                    <span class="text-base">{group.icon}</span>
                                    {group.title}
                                </h3>
                                <div class="flex flex-wrap gap-2">
                                    {group.items.map(filter => (
                                        <label class="flex items-center gap-1.5 cursor-pointer bg-white px-3 py-1.5 rounded-lg border border-stone-200 hover:bg-emerald-50 hover:border-emerald-200 hover:text-emerald-700 transition select-none group">
                                            <input 
                                                type="checkbox" 
                                                id={filter.id || `filter-${filter.key}`}
                                                data-type={filter.type} 
                                                data-key={filter.key}
                                                class="filter-checkbox w-3.5 h-3.5 text-emerald-600 rounded focus:ring-emerald-500 border-stone-300" 
                                            />
                                            <span class="text-sm text-stone-700 group-hover:text-emerald-700">{filter.icon ? filter.icon + ' ' : ''}{filter.label}</span>
                                        </label>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
				</div>
                
                <div class="mt-4 flex justify-between items-center text-xs text-stone-500">
                    <button id="clear-filters" class="text-emerald-600 hover:underline hidden">清除所有條件</button>
                    <span>顯示 <span id="count-display" class="font-bold text-stone-800">{campgrounds.length}</span> 筆結果</span>
                </div>
			</div>
		</div>
	</div>

	<div class="container mx-auto px-4 py-12">
		<div id="results-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
			{campgrounds.map((camp) => (
				<div 
                    class="camp-item opacity-100 transition-opacity duration-300"
                    data-name={camp.name.toLowerCase()}
                    data-city={camp.city}
                    data-area={camp.area}
                    data-tags={camp.tags.join(',')}
                    data-elevation={camp.elevation}
                    data-high-altitude={camp.features.high_altitude}
                    data-glamping={camp.features.has_glamping}
                    data-pet={camp.features.pet_friendly}
                >
					<CampgroundCard camp={camp as Campground} />
				</div>
			))}
		</div>

        {/* No Results Message */}
        <div id="no-results" class="hidden text-center py-20">
            <div class="text-6xl mb-4">🔍</div>
            <h3 class="text-xl font-bold text-stone-800 mb-2">找不到符合條件的營區</h3>
            <p class="text-stone-500">試著減少篩選條件，或搜尋其他關鍵字</p>
        </div>
	</div>
</Layout>

<script>
    // Client-side filtering logic
    let searchInput: HTMLInputElement;
    let filterCity: HTMLSelectElement;
    let sortOrder: HTMLSelectElement;
    let checkboxes: NodeListOf<HTMLInputElement>;
    let clearBtn: HTMLElement | null;
    let resultsGrid: HTMLElement | null;
    let noResults: HTMLElement | null;
    let countDisplay: HTMLElement | null;
    let items: NodeListOf<Element>;
    let toggleBtn: HTMLElement | null;
    let advPanel: HTMLElement | null;
    let toggleIcon: HTMLElement | null;

    // Parse URL URLSearchParameters to autofill search
    function initFromURL() {
        const params = new URLSearchParams(window.location.search);
        const query = params.get('q');
        const city = params.get('city');
        const tag = params.get('tag'); // Supports "?tag=高海拔" or "?tag=冰箱"

        if (query && searchInput) searchInput.value = query;
        if (city && filterCity) filterCity.value = city;
        
        // Handle Tag shortcuts from FilterBar or URL
        // Tries to find a matching checkbox first
        if (tag) {
             let found = false;
             checkboxes.forEach(cb => {
                 // Check if the label contains the tag or key matches
                 const label = cb.parentElement?.textContent || '';
                 if (cb.dataset.key === tag || label.includes(tag)) {
                     cb.checked = true;
                     found = true;
                 }
             });
             
             // If tag is found in checkboxes, expand the panel automatically
             if (found) {
                 toggleAdvancedFilters(true);
             }

             // If not found in checkboxes, put it in search input (fallback)
             if (!found && !query && searchInput) {
                 searchInput.value = tag;
             }
        }

        filterCamps();
    }
    
    function toggleAdvancedFilters(forceOpen = false) {
        if (!advPanel || !toggleIcon) return;
        const isHidden = advPanel.classList.contains('hidden');
        
        if (forceOpen || isHidden) {
            advPanel.classList.remove('hidden');
            toggleIcon.textContent = '▼';
        } else {
            advPanel.classList.add('hidden');
            toggleIcon.textContent = '▶';
        }
    }

    function sortCamps() {
        if (!resultsGrid || !sortOrder) return;
        const order = sortOrder.value;
        const itemArray = Array.from(items) as HTMLElement[];

        if (order === 'default') {
             // Basic sort by name for stability
             itemArray.sort((a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || ''));
        } else if (order === 'elevation-desc') {
            itemArray.sort((a, b) => Number(b.dataset.elevation) - Number(a.dataset.elevation));
        } else if (order === 'elevation-asc') {
            itemArray.sort((a, b) => Number(a.dataset.elevation) - Number(b.dataset.elevation));
        }

        // Re-append to grid
        itemArray.forEach(item => resultsGrid?.appendChild(item));
    }

    function filterCamps() {
        if (!searchInput) return;
        
        const term = searchInput.value.toLowerCase();
        const cityFilter = filterCity?.value || '';
        
        // Get all active checkboxes
        const activeCheckboxes = Array.from(checkboxes).filter(cb => cb.checked);

        // Show/Hide Clear Button
        const hasFilters = term || cityFilter || activeCheckboxes.length > 0;
        if (clearBtn) clearBtn.classList.toggle('hidden', !hasFilters);

        let visibleCount = 0;

        items.forEach((item) => {
            const el = item as HTMLElement;
            const name = el.dataset.name || '';
            const city = el.dataset.city || '';
            const area = el.dataset.area || '';
            const tags = el.dataset.tags || '';
            
            const isHighAlt = el.dataset.highAltitude === 'true';
            const isGlamping = el.dataset.glamping === 'true';
            const isPet = el.dataset.pet === 'true';

            // 1. Text Search
            let matchesSearch = term === '' || 
                                  name.includes(term) || 
                                  city.includes(term) || 
                                  area.includes(term) ||
                                  tags.includes(term);
            
            // Special keyword mapping for features fallback
            if (!matchesSearch) {
                if (term.includes('豪華') && isGlamping) matchesSearch = true;
                if (term.includes('高海拔') && isHighAlt) matchesSearch = true;
                if (term.includes('寵物') && isPet) matchesSearch = true;
            }
            
            // 2. City Match
            const matchesCity = cityFilter === '' || city === cityFilter;

            // 3. Advanced Checkbox Filters
            const matchesAdvanced = activeCheckboxes.every(cb => {
                const type = cb.dataset.type;
                const rawKey = cb.dataset.key || '';
                const keys = rawKey.split('/'); // Support aliases like "有冰箱/冰箱"

                if (type === 'feature') {
                    if (rawKey === 'high_altitude') return isHighAlt;
                    if (rawKey === 'glamping') return isGlamping;
                    if (rawKey === 'pet_friendly') return isPet;
                } else if (type === 'tag') {
                    return keys.some(k => tags.includes(k));
                } else if (type === 'location') {
                     return keys.some(k => 
                        city.includes(k) || 
                        area.includes(k) || 
                        tags.includes(k)
                     );
                }
                return true;
            });

            if (matchesSearch && matchesCity && matchesAdvanced) {
                el.style.display = 'block';
                visibleCount++;
            } else {
                el.style.display = 'none';
            }
        });

        // Update UI State
        if (countDisplay) countDisplay.textContent = visibleCount.toString();
        
        if (visibleCount === 0) {
            resultsGrid?.classList.add('hidden');
            noResults?.classList.remove('hidden');
        } else {
            resultsGrid?.classList.remove('hidden');
            noResults?.classList.add('hidden');
            sortCamps(); // Re-sort visible items
        }
    }

    function clearFilters() {
        if(searchInput) searchInput.value = '';
        if(filterCity) filterCity.value = '';
        if(sortOrder) sortOrder.value = 'default';
        checkboxes.forEach(cb => cb.checked = false);
        filterCamps();
    }

    // Debounce for better performance
    let debounceTimer: ReturnType<typeof setTimeout>;
    function handleInput() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(filterCamps, 150);
    }

    // Main initialization function
    function init() {
         // Re-query DOM elements because they might be new after a transition
        searchInput = document.getElementById('search-input') as HTMLInputElement;
        filterCity = document.getElementById('filter-city') as HTMLSelectElement;
        sortOrder = document.getElementById('sort-order') as HTMLSelectElement;
        checkboxes = document.querySelectorAll('.filter-checkbox');
        clearBtn = document.getElementById('clear-filters');
        resultsGrid = document.getElementById('results-grid');
        noResults = document.getElementById('no-results');
        countDisplay = document.getElementById('count-display');
        items = document.querySelectorAll('.camp-item');
        
        toggleBtn = document.getElementById('toggle-advanced-filters');
        advPanel = document.getElementById('advanced-filters-panel');
        toggleIcon = document.getElementById('toggle-icon');

        if (searchInput) searchInput.addEventListener('input', handleInput);
        if (filterCity) filterCity.addEventListener('change', filterCamps);
        if (sortOrder) sortOrder.addEventListener('change', sortCamps);
        if (clearBtn) clearBtn.addEventListener('click', clearFilters);
        if (toggleBtn) toggleBtn.addEventListener('click', () => toggleAdvancedFilters());
        
        checkboxes.forEach(cb => {
            cb.addEventListener('change', filterCamps);
        });

        initFromURL();
    }
    
    // Astro View Transitions Events
    // Runs on initial load AND after every navigation
    document.addEventListener('astro:page-load', init);
</script>
