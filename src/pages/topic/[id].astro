---
import Layout from '../../layouts/Layout.astro';
import CampgroundCard from '../../components/CampgroundCard.astro';
import NativeAdCard from '../../components/NativeAdCard.astro';
import campgrounds from '../../data/campgrounds_enriched.json';

export async function getStaticPaths() {
  const allCamps = campgrounds;
  
  return [
    {
      params: { id: 'glamping' },
      props: {
        title: '豪華露營推薦',
        subtitle: '免搭帳、星級體驗',
        description: '精選全台豪華露營(Glamping)地點，提供冷氣、舒適床鋪與絕美景觀，不用大包小包也能享受大自然。',
        camps: allCamps.filter(c => c.features.has_glamping)
      }
    },
    {
      params: { id: 'high-altitude' },
      props: {
        title: '高海拔避暑露營',
        subtitle: '雲海、星空、涼爽',
        description: '海拔1000公尺以上的避暑勝地。享受天然冷氣，欣賞壯闊的雲海與無光害的星空。',
        camps: allCamps.filter(c => c.features.high_altitude)
      }
    }
  ];
}

const { title, subtitle, description, camps } = Astro.props;
const { id } = Astro.params;
---

<Layout title={`${title} | 台灣露營地圖`} description={description}>
    <div class="bg-emerald-900 text-white py-16 md:py-24 relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
        <div class="container mx-auto px-4 relative z-10 text-center">
            <h1 class="text-4xl md:text-5xl font-extrabold mb-4">{title}</h1>
            <p class="text-xl text-emerald-100 font-light mb-6">{subtitle}</p>
            <p class="max-w-2xl mx-auto text-emerald-200/80 leading-relaxed">
                {description}
            </p>
        </div>
    </div>

    <div class="container mx-auto px-4 py-12">
        <div class="flex justify-between items-center mb-8 border-b border-stone-200 pb-4">
            <span class="text-stone-500 text-sm">共找到 <strong class="text-stone-800">{camps.length}</strong> 個營區</span>
            
            {/* Simple Sort/Filter Placeholder - Can be expanded later */}
            <div class="text-sm text-stone-500">
                排序：<span class="font-medium text-emerald-700 cursor-pointer">熱門程度</span>
            </div>
        </div>

        {camps.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {camps.map((camp, index) => (
                    <>
                        <CampgroundCard camp={camp} />
                        {/* Insert Native Ad every 6 items */}
                        {(index + 1) % 6 === 0 && <NativeAdCard />}
                    </>
                ))}
            </div>
        ) : (
            <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-100">
                <p class="text-xl text-stone-400 mb-2">這裡目前還沒有資料喔</p>
                <p class="text-stone-500">我們會持續更新營區資訊，敬請期待！</p>
                <a href="/" class="inline-block mt-6 text-emerald-600 hover:text-emerald-700 font-medium">回首頁逛逛 &rarr;</a>
            </div>
        )}
    </div>
</Layout>
