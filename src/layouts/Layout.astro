---
import MobileHeader from '../components/MobileHeader.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "Outdoor Camping World 台灣站 (Since 2004) - 您的終極露營指南。收錄全台 300+ 熱門營區地圖、豪華露營推薦，以及專業的露營裝備導購評測。" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/social-card.jpg', Astro.url); // 需要在 public 放置預設圖

// 結構化資料：明確告訴 Google 品牌的歷史與權威
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Outdoor Camping World",
  "url": "https://www.outdoorcampingworld.com",
  "logo": "https://www.outdoorcampingworld.com/logo.png",
  "foundingDate": "2004",
  "description": "Gear up for the great outdoors. Since 2004.",
  "sameAs": [
    "https://www.facebook.com/outdoorcampingworld", 
    "https://twitter.com/outdoorcampingworld"
  ]
});
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Primary -->
		<title>{title} | Outdoor Camping World - Since 2004</title>
		<meta name="title" content={`${title} | Outdoor Camping World - Since 2004`} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

        <script type="application/ld+json" set:html={schema} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={`${title} | Outdoor Camping World - Since 2004`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:site_name" content="Outdoor Camping World (台灣站)" />
		<meta property="og:locale" content="zh_TW" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={`${title} | Outdoor Camping World - Since 2004`} />
		<meta property="twitter:description" content="Gear up for the great outdoors. Since 2004." />
		<meta property="twitter:image" content={socialImageURL} />

		<slot name="head" />

		<!-- Mobile Theme Color -->
		<meta name="theme-color" content="#ffffff" />
		
		<ClientRouter />

		<!-- iChannels Affiliate Script (Auto Link Converter) -->
		<script is:inline>
			// Define configuration variables globally
			var oeya_member = "3F8Gh";
			var oeya_uid1 = "";
			var oeya_uid2 = "";
			var oeya_uid3 = "";
			var oeya_uid4 = "";
			var oeya_uid5 = "";
		</script>
		<script is:inline src="https://www.conn.tw/track/script/oeya_member_url.js"></script>
	</head>
	<body class="bg-stone-50 min-h-screen text-stone-800 font-sans flex flex-col pb-16 md:pb-0">
		<MobileHeader />

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="bg-stone-900 text-stone-400 py-12 mt-20 hidden md:block">
			<div class="container mx-auto px-4">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div>
						<h3 class="text-white font-bold text-lg mb-4">關於本站</h3>
						<p class="text-sm leading-relaxed">
							Outdoor Camping World 台灣站 (Since 2004) 致力於提供最透明、最準確的露營區資訊。
							結合 AI 技術，為您分析海拔氣候與設施特色。
						</p>
					</div>
					<div>
						<h3 class="text-white font-bold text-lg mb-4">熱門連結</h3>
						<ul class="space-y-2 text-sm">
							<li><a href="/topic/high-altitude" class="hover:text-white transition">高海拔避暑</a></li>
							<li><a href="/topic/glamping" class="hover:text-white transition">豪華露營</a></li>
							<li><a href="/search" class="hover:text-white transition">全台營區搜尋</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-white font-bold text-lg mb-4">免責聲明</h3>
						<p class="text-xs leading-relaxed">
							本站資訊由 AI 輔助整理，實際狀況請以營區官方公告為準。
							部分連結可能包含合作推廣內容。
						</p>
					</div>
				</div>
				<div class="border-t border-stone-800 mt-8 pt-8 text-center text-xs">
					&copy; 2004-{new Date().getFullYear()} Outdoor Camping World. All rights reserved.
				</div>
			</div>
		</footer>

		<!-- Mobile Bottom Navigation -->
		<nav class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-stone-200 z-50 pb-safe">
			<div class="grid grid-cols-4 h-16">
				<a href="/" class="flex flex-col items-center justify-center text-stone-500 hover:text-emerald-700 active:text-emerald-700 transition-colors gap-1">
					<span class="text-xl">🏠</span>
					<span class="text-[10px] font-medium">首頁</span>
				</a>
				<a href="/search" class="flex flex-col items-center justify-center text-stone-500 hover:text-emerald-700 active:text-emerald-700 transition-colors gap-1">
					<span class="text-xl">🔍</span>
					<span class="text-[10px] font-medium">搜尋</span>
				</a>
				<a href="/topic/glamping" class="flex flex-col items-center justify-center text-stone-500 hover:text-emerald-700 active:text-emerald-700 transition-colors gap-1">
					<span class="text-xl">✨</span>
					<span class="text-[10px] font-medium">豪華</span>
				</a>
				<a href="/topic/high-altitude" class="flex flex-col items-center justify-center text-stone-500 hover:text-emerald-700 active:text-emerald-700 transition-colors gap-1">
					<span class="text-xl">⛰️</span>
					<span class="text-[10px] font-medium">高山</span>
				</a>
			</div>
		</nav>

		<script>
            // 🪙 Global Affiliate Link Rewriter
            // Automatically wraps external e-commerce links with iChannels redirection
            const ICHANNELS_PREFIX = "https://product.mchannles.com/redirect_wa.php?k=3F8Gh&tourl=";
            
            // Domains to be wrapped (Extend list as needed)
            const TARGET_DOMAINS = [
                "momoshop.com.tw",
                "klook.com",
                "kkday.com",
                "shopee.tw",
            ];

            function processAffiliateLink(anchor) {
                if (!anchor || !anchor.href) return;
                const url = anchor.href;

                // Skip if already wrapped
                if (url.includes('product.mchannles.com')) return;

                // Check if domain matches target list
                const isTargetDomain = TARGET_DOMAINS.some(domain => url.includes(domain));
                
                if (isTargetDomain) {
                    anchor.href = `${ICHANNELS_PREFIX}${encodeURIComponent(url)}`;
                    // SEO Turbo: Add "nofollow sponsored" to retain Link Juice on the aged domain
                    anchor.rel = "nofollow sponsored"; 
                    anchor.target = "_blank";
                }
            }

            function initAffiliateLinks() {
                // Process existing links
                document.querySelectorAll('a[href^="http"]').forEach(processAffiliateLink);
            }

            // Observer for dynamic content (like Search results or Lazy loaded items)
            const adObserver = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    mutation.addedNodes.forEach((node) => {
                        if (node.nodeType === 1) { // ELEMENT_NODE
                             const el = node; // Cast to Element
                             // 1. Check if the element itself is a target link
                             if (el.tagName === 'A') processAffiliateLink(el);
                             
                             // 2. Check for links inside the element
                             if (el.querySelectorAll) {
                                 el.querySelectorAll('a[href^="http"]').forEach(processAffiliateLink);
                             }
                        }
                    });
                });
            });

            // Start observing
            function startObserver() {
                initAffiliateLinks();
                adObserver.disconnect(); // Prevent duplicates
                adObserver.observe(document.body, {
                    childList: true,
                    subtree: true
                });
            }

            // Run on initial load & view transitions
            document.addEventListener('astro:page-load', startObserver);
            document.addEventListener('DOMContentLoaded', startObserver);
        </script>
	</body>
</html>
