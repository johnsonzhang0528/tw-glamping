---
// src/components/CookieConsent.astro
---

<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 bg-stone-900 border-t border-stone-800 p-4 z-[100] transform translate-y-full transition-transform duration-300">
    <div class="container mx-auto max-w-6xl flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-stone-300 text-sm md:text-base pr-4">
            <p>
                本站使用 Cookies 與 Google Analytics 類似技術以提供最佳的使用者體驗。
                繼續瀏覽即表示您同意我們的
                <a href="/privacy/" class="text-emerald-400 hover:text-emerald-300 underline font-medium">隱私權政策</a>。
            </p>
        </div>
        <div class="flex items-center gap-3 shrink-0 w-full md:w-auto">
            <button id="cookie-reject" class="flex-1 md:flex-none py-2 px-4 rounded-lg border border-stone-600 text-stone-400 text-xs hover:bg-stone-800 transition">
                僅必要 Cookie
            </button>
            <button id="cookie-accept" class="flex-1 md:flex-none py-2 px-6 rounded-lg bg-emerald-600 text-white font-bold text-sm hover:bg-emerald-500 shadow-lg shadow-emerald-900/50 transition">
                同意
            </button>
        </div>
    </div>
</div>

<script is:inline>
    (function() {
        const banner = document.getElementById('cookie-banner');
        const acceptBtn = document.getElementById('cookie-accept');
        const rejectBtn = document.getElementById('cookie-reject');

        // Check LocalStorage
        const consent = localStorage.getItem('cookie_consent');
        
        // Show banner if no choice made
        if (!consent) {
            // Delay slightly for animation effect
            setTimeout(() => {
                banner.classList.remove('translate-y-full');
            }, 1000);
        } else {
            // Verify consent state for GTM (if already accepted)
            if (consent === 'accepted') {
                window.shouldLoadGTM = true; // Signal Global Layout
            }
        }

        acceptBtn.addEventListener('click', () => {
             localStorage.setItem('cookie_consent', 'accepted');
             banner.classList.add('translate-y-full');
             
             // Trigger GTM load immediately
             window.shouldLoadGTM = true;
             // Dispatch custom event that Layout.astro can listen to
             window.dispatchEvent(new Event('cookie-accepted'));
        });

        rejectBtn.addEventListener('click', () => {
             localStorage.setItem('cookie_consent', 'rejected');
             banner.classList.add('translate-y-full');
        });
    })();
</script>