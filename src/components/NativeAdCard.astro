---
// src/components/NativeAdCard.astro
import { ads, getBadgeClasses } from '../data/adContent';

interface Props {
    adIndex?: number; // Optional: Force a specific ad by index
}

const { adIndex } = Astro.props;

// 預先處理廣告資料，把 Badge 的 Class 算好
const adsWithClasses = ads.map(ad => ({
    ...ad,
    badges: ad.badges.map(b => ({
        ...b,
        classString: `text-[10px] font-bold px-2 py-0.5 rounded-full border ${getBadgeClasses(b.color)}`
    }))
}));

// Logic:
// 1. If adIndex is provided, use that (modulo length to be safe).
// 2. If not, pick a random one (Legacy behavior).
let selectedIndex = 0;
if (typeof adIndex === 'number') {
    selectedIndex = adIndex % ads.length;
} else {
    selectedIndex = Math.floor(Math.random() * ads.length);
}

const selectedAd = adsWithClasses[selectedIndex];
---

<article 
  class="bg-white rounded-2xl shadow-sm border border-stone-100 h-full flex flex-col relative group hover:shadow-lg hover:border-emerald-200 transition-all duration-300 overflow-hidden js-native-ad"
  data-ads-pool={JSON.stringify(adsWithClasses)}
>
  
  <div class="absolute top-3 right-3 z-10">
    <span class="bg-stone-900/80 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-1 rounded border border-white/20 tracking-wider">
      SPONSORED
    </span>
  </div>
  
  <div class="h-48 relative overflow-hidden bg-stone-200">
     <img 
        src={selectedAd.image} 
        alt={selectedAd.title} 
        width="800"
        height="450"
        loading="lazy" 
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 js-ad-img"
     />
     <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
  </div>

  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
        <div class="flex gap-2 mb-3 js-ad-badges">
             {selectedAd.badges.map(badge => (
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full border ${getBadgeClasses(badge.color)}`}>
                    {badge.text}
                </span>
             ))}
        </div>

        <h3 class="font-bold text-xl text-stone-800 mb-2 group-hover:text-emerald-700 transition-colors js-ad-title">
            {selectedAd.title}
        </h3>
        <p class="text-stone-600 text-sm line-clamp-2 mb-4 leading-relaxed js-ad-desc">
            {selectedAd.desc}
        </p>
    </div>
    
    <div class="mt-auto">
        <span class="w-full block text-center bg-stone-100 group-hover:bg-emerald-600 group-hover:text-white text-stone-600 text-sm font-bold py-2.5 rounded-lg transition-colors duration-300 js-ad-cta">
            {selectedAd.cta}
        </span>
    </div>
  </div>

  <a href={selectedAd.link} target="_blank" rel="nofollow sponsored" class="absolute inset-0 z-0 js-ad-link" aria-label={selectedAd.title}></a>
</article>
