---
// src/components/WeatherWidget.astro

interface ForecastDay {
  date: string;
  max_temp: number;
  min_temp: number;
  rain_prob: number;
  weather_code: number;
  label: string;
  icon: string;
}

interface HourlyData {
  time: string;
  temp: number;
  pop: number;
  wind: number;
  icon: string;
  uv?: number;
}

interface Props {
  forecast: ForecastDay[] | { daily: ForecastDay[], hourly: HourlyData[] };
  city?: string; // Used for fallback message
  updatedAt?: string; // ISO string
}

const { forecast, city, updatedAt } = Astro.props;

// Normalize Data
const dailyForecast = Array.isArray(forecast) ? forecast : (forecast?.daily || []);
const hourlyForecast = Array.isArray(forecast) ? [] : (forecast?.hourly || []);

// Formatting Helpers
function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const today = new Date();
  
  // Check if it's today
  if (date.toDateString() === today.toDateString()) return "今天";
  
  return `${date.getMonth() + 1}/${date.getDate()}`;
}

function getDayName(dateStr: string) {
  const date = new Date(dateStr);
  const days = ['週日', '週一', '週二', '週三', '週四', '週五', '週六'];
  return days[date.getDay()];
}

// Map icon codes to Emojis (Lightweight & Colorful)
const ICONS: Record<string, string> = {
  "clear-day": "☀️",
  "partly-cloudy-day": "⛅",
  "cloudy": "☁️",
  "overcast": "☁️",
  "fog": "🌫️",
  "drizzle": "🌦️",
  "rain": "🌧️",
  "sleet": "🌨️",
  "snow": "❄️",
  "thunderstorm": "⛈️"
};

// Calculate Tips (Smart Analysis for 14 Days)
const tips = [];
const getSimpleDate = (dStr: string) => {
    const date = new Date(dStr);
    return `${date.getMonth() + 1}/${date.getDate()}`;
};

// 1. Extreme Weather Checks (Priority: Warning > Heavy Rain)
// Rain Check (High Probability > 60%)
const rainyDays = dailyForecast.filter(d => d.rain_prob >= 60);
if (rainyDays.length > 0) {
    const firstRain = rainyDays[0];
     tips.push({ 
        type: 'warning', 
        text: `${getSimpleDate(firstRain.date)} 起降雨機率高 (${firstRain.rain_prob}%)，建議備妥雨具 ☔` 
    });
}

// Cold Check (Min Temp <= 10)
const coldDays = dailyForecast.filter(d => d.min_temp <= 8);
if (coldDays.length > 0) {
    // Find the coldest day
    const coldest = coldDays.reduce((prev, curr) => prev.min_temp < curr.min_temp ? prev : curr);
    tips.push({ 
        type: 'cold', 
        text: `預測 ${getSimpleDate(coldest.date)}前後 低溫下探 ${coldest.min_temp}°C，請務必做好保暖 🧥` 
    });
}

// Heat Check (Max Temp >= 32)
const hotDays = dailyForecast.filter(d => d.max_temp >= 32);
if (hotDays.length > 0) {
     const firstHot = hotDays[0];
     tips.push({ 
        type: 'hot', 
        text: `${getSimpleDate(firstHot.date)} 預測高溫達 ${firstHot.max_temp}°C，請注意防曬與補水 ☀️` 
    });
}

// 2. Weekend Opportunity Check (Priority: Good Weather)
// Logic: Find the nearest cluster of Fri/Sat/Sun
const weekendGroups: ForecastDay[][] = [];
let currentGroup: ForecastDay[] = [];

dailyForecast.forEach((d, idx) => {
    const date = new Date(d.date);
    const day = date.getDay();
    if (day === 5 || day === 6 || day === 0) { // Fri, Sat, Sun
        // Check continuity with previous item in group
        // Since we iterate array sequentially, we just need to calculate index diff if we tracked indexes, 
        // or just rely on the fact that if we hit a non-weekend day, we flushed the group.
        // But here we only enter this block for weekend days.
        // We need to know if the previous day in forecast was pushed to currentGroup.
        const prevInGroup = currentGroup[currentGroup.length - 1];
        if (!prevInGroup) {
            currentGroup.push(d);
        } else {
            // Check if this 'd' is the day immediately after 'prevInGroup'
            const prevDate = new Date(prevInGroup.date);
            const diffTime = Math.abs(date.getTime() - prevDate.getTime());
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); 
            if (diffDays <= 1) {
                currentGroup.push(d);
            } else {
                weekendGroups.push(currentGroup);
                currentGroup = [d];
            }
        }
    }
});
if (currentGroup.length > 0) weekendGroups.push(currentGroup);

// Analyze the first Weekend Group found
const targetWeekend = weekendGroups[0];
if (targetWeekend && targetWeekend.length > 0) {
    const isNice = targetWeekend.every(d => d.rain_prob < 40 && d.min_temp > 10 && d.max_temp < 32);
    // Only show if we strictly haven't shown too many warnings yet
    if (isNice) {
        const range = targetWeekend.length > 1 
            ? `${getSimpleDate(targetWeekend[0].date)}-${getSimpleDate(targetWeekend[targetWeekend.length-1].date)}`
            : getSimpleDate(targetWeekend[0].date);
        
        tips.push({ 
            type: 'good', 
            text: `本週末 (${range}) 天氣舒適，非常適合露營！ ⛺` 
        });
    }
}

// 3. Fallback / General Generalization
if (tips.length === 0 && dailyForecast.length > 0) {
     const isGenerallyGood = dailyForecast.every(d => d.rain_prob < 45); // Relaxed threshold
     const range = `${getSimpleDate(dailyForecast[0].date)}~${getSimpleDate(dailyForecast[dailyForecast.length-1].date)}`;
     
     if (isGenerallyGood) {
         tips.push({ 
             type: 'good', 
             text: `未來兩週 (${range}) 氣候大致穩定，適合安排戶外行程 🏕️` 
        });
     } else {
         tips.push({ type: 'info', text: `未來兩週 (${range}) 天氣變化較大，請留意最新預報 ℹ️` });
     }
}

// Filter and Sort Tips (Priority: Warning > Cold > Good > Info)
// Show max 2 unqiue tips
const uniqueTips = tips.filter((t, index, self) => 
    index === self.findIndex((t2) => t2.type === t.type && t2.text === t.text)
);

const displayTips = uniqueTips.slice(0, 2);

---

<div class="bg-white rounded-2xl shadow-sm border border-stone-200 overflow-hidden font-sans">
  
  {/* Header */}
  <div class="bg-emerald-50/50 px-5 py-3 border-b border-emerald-100 flex justify-between items-center">
    <div class="flex items-center gap-2">
        <span class="text-xl">🌤️</span>
    <h2 class="font-bold text-stone-800 text-xl border-l-4 border-emerald-500 pl-3">未來兩周天氣預報</h2>
    </div>
    {updatedAt && (
        <div class="hidden md:flex items-center gap-1.5 bg-white/80 backdrop-blur pl-1.5 pr-2.5 py-1 rounded-full border border-stone-200 shadow-sm">
             <div class="bg-emerald-100 text-emerald-600 rounded-full p-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
                </svg>
             </div>
             <span class="text-xs font-bold text-stone-600 tabular-nums">
                {new Date(updatedAt).toLocaleDateString('zh-TW', { month: '2-digit', day: '2-digit' })} 更新
             </span>
        </div>
    )}
    {/* Mobile simpler version */}
    {updatedAt && (
        <span class="md:hidden text-xs font-medium text-stone-400">
             {new Date(updatedAt).toLocaleDateString('zh-TW', { month: 'numeric', day: 'numeric' })} 更新
        </span>
    )}
  </div>

  {/* Tips Section */}
  {displayTips.length > 0 && (
    <div class="px-5 pt-4">
        {displayTips.map(tip => (
            <div class={`text-xs md:text-sm px-3 py-2 rounded-lg mb-2 flex items-center gap-2 font-medium
                ${tip.type === 'warning' ? 'bg-amber-50 text-amber-800 border border-amber-100' : ''}
                ${tip.type === 'cold' ? 'bg-blue-50 text-blue-800 border border-blue-100' : ''}
                ${tip.type === 'hot' ? 'bg-orange-50 text-orange-800 border border-orange-100' : ''}
                ${tip.type === 'good' ? 'bg-emerald-50 text-emerald-800 border border-emerald-100' : ''}
                ${tip.type === 'info' ? 'bg-stone-50 text-stone-600' : ''}
            `}>
                <span>
                 {tip.type === 'warning' && '⚠️'}
                 {tip.type === 'cold' && '❄️'}
                 {tip.type === 'hot' && '☀️'}
                 {tip.type === 'good' && '✨'}
                 {tip.type === 'info' && 'ℹ️'}
                </span>
                {tip.text}
            </div>
        ))}
    </div>
  )}

  {/* Chart Section */}
  <div class="px-4 pb-6 mt-4 grid grid-cols-1 lg:grid-cols-2 gap-8">
      {/* Daily Chart */}
      <div class="relative h-64 w-full">
          <h3 class="text-xs font-bold text-stone-500 mb-2 uppercase tracking-wide">兩週氣溫趨勢</h3>
          <canvas id="weatherChart"></canvas>
      </div>

      {/* Hourly Chart */}
      {hourlyForecast.length > 0 && (
          <div class="relative h-64 w-full border-t lg:border-t-0 lg:border-l border-stone-100 pt-6 lg:pt-0 lg:pl-6">
              <h3 class="text-xs font-bold text-stone-500 mb-2 uppercase tracking-wide">24小時詳細預報 (紫外線/降雨)</h3>
              <canvas id="hourlyChart"></canvas>
          </div>
      )}
  </div>

  {/* Hidden Data for JS */}
  <div id="weather-data" data-forecast={JSON.stringify(dailyForecast)} data-hourly={JSON.stringify(hourlyForecast)} class="hidden"></div>
  
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script is:inline>
    document.addEventListener('astro:page-load', initCharts);
    document.addEventListener('DOMContentLoaded', initCharts);

    function initCharts() {
        initDailyChart();
        initHourlyChart();
    }

    function initDailyChart() {
        const ctx = document.getElementById('weatherChart');
        const dataEl = document.getElementById('weather-data');
        
        if (!ctx || !dataEl) return;
        
        // Prevent double init
        if (ctx.classList.contains('chart-initialized')) return;
        ctx.classList.add('chart-initialized');

        const rawData = JSON.parse(dataEl.dataset.forecast || '[]');
        if (rawData.length === 0) return;

        const labels = rawData.map(d => {
            const date = new Date(d.date);
            return `${date.getMonth() + 1}/${date.getDate()}`;
        });
        const maxTemps = rawData.map(d => d.max_temp);
        const minTemps = rawData.map(d => d.min_temp);

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: '最高溫',
                        data: maxTemps,
                        borderColor: '#f97316', // Orange 500
                        backgroundColor: '#f97316',
                        tension: 0.4,
                        borderWidth: 3
                    },
                    {
                        label: '最低溫',
                        data: minTemps,
                        borderColor: '#0284c7', // Sky 600
                        backgroundColor: '#0284c7',
                        tension: 0.4,
                        borderWidth: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { font: { size: 12 }, usePointStyle: true }
                    },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    y: { 
                        display: true,
                        ticks: { callback: function(value) { return value + '°C'; } }     
                    },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    function initHourlyChart() {
        const ctx = document.getElementById('hourlyChart');
        const dataEl = document.getElementById('weather-data');

        if (!ctx || !dataEl) return;
        if (ctx.classList.contains('chart-initialized')) return;
        ctx.classList.add('chart-initialized');

        const rawHourly = JSON.parse(dataEl.dataset.hourly || '[]');
        if (rawHourly.length === 0) return;

        // 🟢 Time Shifting Logic (Limit to 24h as requested)
        const now = new Date();
        const futureHourly = rawHourly.filter(h => new Date(h.time) > now).slice(0, 24);

        if (futureHourly.length === 0) return;

        const labels = futureHourly.map((h, idx) => {
            const date = new Date(h.time);
            const hours = date.getHours();
            
            // Format: 14:00 (Always show hour)
            const timeStr = `${hours.toString().padStart(2, '0')}:00`;

            const weatherMap = {
                'clear-day': '晴天',
                'partly-cloudy-day': '多雲',
                'cloudy': '多雲',
                'overcast': '陰天',
                'fog': '起霧',
                'drizzle': '毛毛雨',
                'sleet': '凍雨',
                'rain': '下雨',
                'snow': '下雪',
                'thunderstorm': '雷雨'
            };
            const weatherLabel = weatherMap[h.icon] || h.icon;

            return [timeStr, weatherLabel]; // Multi-line label with Chinese text
        });
        
        const rainProbs = futureHourly.map(h => h.pop);
        const uvs = futureHourly.map(h => h.uv || 0);

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: '降雨機率 (%)',
                        data: rainProbs,
                        type: 'bar',
                        backgroundColor: (ctx) => {
                           const val = ctx.raw;
                           // Gradient color for rain probability
                           if (val >= 70) return '#ef4444'; // Red-500
                           if (val >= 40) return '#f59e0b'; // Amber-500
                           return '#3b82f6'; // Blue-500
                        },
                        yAxisID: 'yRain',
                        borderRadius: 4,
                        maxBarThickness: 20
                    },
                    {
                        label: '紫外線 (UV)',
                        data: uvs,
                        type: 'line',
                        borderColor: '#f43f5e', // Rose 500
                        backgroundColor: '#f43f5e',
                        borderWidth: 2,
                        pointRadius: 2, // Slightly larger points
                        yAxisID: 'yUV',
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { boxWidth: 12, font: { size: 11 }, usePointStyle: true }
                    },
                     tooltip: {
                        callbacks: {
                            title: (items) => {
                                const idx = items[0].dataIndex;
                                const date = new Date(futureHourly[idx].time);
                                return `${date.getMonth()+1}/${date.getDate()} ${date.getHours()}:00 ${futureHourly[idx].icon}`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            maxRotation: 0,
                            autoSkip: true,
                            maxTicksLimit: 8, // Avoid overcrowding
                            font: { size: 10 }
                        }
                    },
                    yRain: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: { display: true, text: '降雨 %', font: { size: 10 } },
                        min: 0,
                        max: 100,
                        grid: { display: false }
                    },
                    yUV: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: { display: true, text: 'UV 指數', font: { size: 10 } },
                        min: 0,
                        max: 12, // Standard UV Index max
                        grid: { borderDash: [2, 4], color: '#f3f4f6' }
                    }
                }
            }
        });
    }
  </script>
</div>
