{
  "headers": [
    {
      "source": "/feeds/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/modules/(.*)",
      "destination": "/",
      "statusCode": 410
    },
    {
      "source": "/upload/(.*)",
      "destination": "/",
      "statusCode": 410
    },
    {
      "source": "/product/(.*)",
      "destination": "/",
      "statusCode": 410
    },
    {
      "source": "/member/(.*)",
      "destination": "/",
      "statusCode": 410
    },
    {
      "source": "/(.*)\\.php",
      "destination": "/",
      "statusCode": 410
    },
    {
      "source": "/(.*)\\.html",
      "destination": "/",
      "statusCode": 410
    }
  ]
}